{
  "$schema": "https://xschema.dev/schemas/typescript.jsonc",
  "namespace": "test",
  "schemas": [
    {
      "id": "ConstObject",
      "sourceType": "json",
      "source": {
        "const": { "type": "admin", "level": 5 }
      },
      "adapter": "@xschemadev/zod"
    },
    {
      "id": "ConstArray",
      "sourceType": "json",
      "source": {
        "const": [1, 2, 3]
      },
      "adapter": "@xschemadev/zod"
    },
    {
      "id": "HeterogeneousEnum",
      "sourceType": "json",
      "source": {
        "enum": ["admin", { "type": "user", "level": 1 }, 42]
      },
      "adapter": "@xschemadev/zod"
    },
    {
      "id": "ObjectEnum",
      "sourceType": "json",
      "source": {
        "enum": [
          { "type": "admin", "level": 5 },
          { "type": "user", "level": 1 }
        ]
      },
      "adapter": "@xschemadev/zod"
    }
  ]
}
