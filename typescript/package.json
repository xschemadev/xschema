{
  "name": "xschema-typescript",
  "private": true,
  "workspaces": ["packages/*", "packages/adapters/*", "example"],
  "scripts": {
    "build": "bun run --filter '@xschemadev/core' build && bun run --filter '@xschemadev/*' build",
    "typecheck": "bun run --filter '@xschemadev/*' typecheck",
    "compliance:all": "bun run --filter './packages/adapters/*' compliance"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
