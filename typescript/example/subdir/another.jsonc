{
	// Another config file - namespace defaults to "another"
	// Multiple config files are merged into one output
	"$schema": "https://xschema.dev/schemas/typescript.jsonc",
	"schemas": [
		{
			"id": "TSConfig",
			"sourceType": "url",
			"source": "https://json.schemastore.org/tsconfig.json",
			"adapter": "@xschemadev/zod"
		},
		{
			"id": "TSConfigNative",
			"sourceType": "url",
			"source": "https://json.schemastore.org/tsconfig.json",
			"adapter": "@xschemadev/typescript"
		},
		{
			"id": "Native",
			"sourceType": "json",
			"source": {
				"fruits": [
					"apple",
					"orange",
					"pear"
				],
				"vegetables": [
					{
						"veggieName": "potato",
						"veggieLike": true
					},
					{
						"veggieName": "broccoli",
						"veggieLike": false
					}
				]
			},
			"adapter": "@xschemadev/typescript"
		}
	]
}
