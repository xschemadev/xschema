{
	// XSchema config file - detected by $schema URL
	// Namespace defaults to filename: "user"
	"$schema": "https://xschema.dev/schemas/typescript.jsonc",
	"schemas": [
		{
			// Schema from a local file (relative to this config file)
			"id": "Calendar",
			"sourceType": "file",
			"source": "./calendar.json",
			"adapter": "@xschemadev/zod"
		},
		{
			// Schema from a local file using ArkType adapter
			"id": "User",
			"sourceType": "file",
			"source": "./source.json",
			"adapter": "@xschemadev/arktype"
		}
	]
}
