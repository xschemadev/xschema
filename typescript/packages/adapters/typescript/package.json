{
  "name": "@xschemadev/typescript",
  "version": "0.1.0",
  "type": "module",
  "description": "XSchema TypeScript Type-Only Adapter - generates TypeScript type definitions from JSON Schema (no runtime validation)",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "xschema-typescript": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xschemadev/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
