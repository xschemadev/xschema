{
	"name": "@xschemadev/typebox",
	"version": "0.1.0",
	"type": "module",
	"description": "XSchema TypeBox Adapter",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"bin": {
		"xschema-typebox": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"compliance": "../../../../cli/xschema compliance --dev-report"
	},
	"dependencies": {
		"@xschemadev/core": "workspace:*"
	},
	"devDependencies": {
		"@sinclair/typebox": "^0.34.0",
		"ajv": "^8.17.1",
		"ajv-formats": "^3.0.1"
	},
	"peerDependencies": {
		"@sinclair/typebox": "^0.34.0"
	}
}
