{
	"name": "@xschemadev/zod",
	"version": "0.0.4",
	"type": "module",
	"description": "XSchema Zod Adapter",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
