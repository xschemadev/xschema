{
	"name": "@xschemadev/zod",
	"version": "0.3.0",
	"type": "module",
	"description": "XSchema Zod Adapter",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"bin": {
		"xschema-zod": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"compliance": "ADAPTER=$PWD && cd ../../../../cli && go run . compliance --dev-report --adapter-path $ADAPTER",
		"type-fidelity": "bun type-probe/type-fidelity.ts"
	},
	"dependencies": {
		"@xschemadev/core": "workspace:*"
	},
	"devDependencies": {
		"zod": "^3.24.0"
	},
	"peerDependencies": {
		"zod": "^3.0.0"
	}
}
