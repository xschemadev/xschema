		"compliance": "../../../../cli/xschema compliance --dev-report"
	},
	"dependencies": {
		"@xschemadev/core": "workspace:*",
		"json-schema-to-zod": "^2.4.1"
	},
	"devDependencies": {
		"zod": "^3.24.0"
	},
	"peerDependencies": {
		"zod": "^3.0.0"
	}
