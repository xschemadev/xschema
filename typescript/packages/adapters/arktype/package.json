{
	"name": "@xschemadev/arktype",
	"version": "0.1.2",
	"type": "module",
	"description": "XSchema ArkType Adapter",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"bin": {
		"xschema-arktype": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"compliance": "ADAPTER=$PWD && cd ../../../../cli && go run . compliance --dev-report --adapter-path $ADAPTER"
	},
	"dependencies": {
		"@xschemadev/core": "workspace:*"
	},
	"devDependencies": {
		"arktype": "^2.1.20"
	},
	"peerDependencies": {
		"arktype": "^2.0.0"
	}
}
