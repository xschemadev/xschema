    {
      "id": "US-016",
      "title": "Update Generator to accept ProcessedSchema",
      "description": "As a developer, I want Generator to accept ProcessedSchema (already bundled) instead of doing bundling itself.",
      "acceptanceCriteria": [
        "Change Generator input from `[]RetrievedSchema` to `[]ProcessedSchema`",
        "Remove bundling logic from Generator (moved to Processor)",
        "Simplify to: group by adapter → call adapter CLI",
