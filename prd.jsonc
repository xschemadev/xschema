{
  "project": "xschema-adapters",
  "description": "Compliance Known Issues System - exclude intentional limitations from compliance percentages",
  "userStories": [
    {
      "id": "US-001",
      "title": "Known issues file structure",
      "description": "As a maintainer, I need a JSON file per adapter listing known issues with explanations.",
      "acceptanceCriteria": [
        "File location: typescript/packages/adapters/{adapter}/compliance/known-issues.json",
        "Schema: array of groups with 'reason' (string) and 'tests' (array of test paths)",
        "Test path format: {draft}/{keyword}/{group}/{test}",
        "Go types KnownIssues and KnownIssueGroup exist in cli/compliance/types.go",
        "Typecheck passes"
      ],
      "passes": true,
      "notes": "Completed in commit 92dcc91. Zod known-issues.json created as reference."
    },
    {
      "id": "US-002",
      "title": "Runner skips known issue tests",
      "description": "As a developer, I want known-failing tests skipped during compliance runs.",
      "acceptanceCriteria": [
        "Runner loads known-issues.json from adapter's compliance directory",
        "Tests matching known issue paths are not executed",
        "Skipped known tests don't appear in pass/fail/skip counts",
        "CLI output shows 'X known issues' in summary line",
        "Running 'xschema compliance --adapter=zod' shows ~146 known issues skipped",
        "Typecheck passes"
      ],
      "passes": true,
      "notes": "Implemented with pre-filtering before bundling phase. Shows 114 total known issues across all drafts."
    },
    {
      "id": "US-003",
      "title": "JSON results track known issues separately",
      "description": "As a developer, I want JSON results to exclude known issues from percentages.",
      "acceptanceCriteria": [
        "Add knownIssues field to draft results: { count: number, items: Array<{ path, reason }> }",
        "summary.total excludes known issue tests",
        "summary.percentage = passed / (total - knownIssueCount) * 100",
        "Each known issue entry includes test path and reason from JSON file",
        "Typecheck passes"
      ],
      "passes": true,
      "notes": "Added KnownIssueItem/KnownIssuesSummary types. JSON now includes {count, items: [{path, reason}]}."
    },
    {
      "id": "US-004",
      "title": "CLI dev report shows known issues",
      "description": "As a developer, I want CLI output to show known issues separately.",
      "acceptanceCriteria": [
        "Summary line format: 'X passed, Y failed, Z skipped, W known issues'",
        "Percentage excludes known issues from denominator",
        "Known issues section lists reasons with test counts per reason",
        "Typecheck passes"
      ],
      "passes": true,
      "notes": "Per-draft line now shows 'X passed, Y failed, Z known (%)'. Known Issues section at end shows breakdown by reason."
    },
    {
      "id": "US-005",
      "title": "Web compliance page known issues section",
      "description": "As a docs user, I want compliance page to separate known limitations from unexpected failures.",
      "acceptanceCriteria": [
        "'Known Behaviors' section displays known issues grouped by reason",
        "Each reason shows expandable test list",
        "'Issues' section only shows unexpected failures",
        "Summary table percentages exclude known issues",
        "Typecheck passes",
        "Verify in browser using dev-browser skill"
      ],
      "passes": false,
      "notes": ""
    },
    {
      "id": "US-006",
      "title": "REPORT.md generation with known issues",
      "description": "As a developer, I want markdown report to show known issues separately.",
      "acceptanceCriteria": [
        "Summary table shows known issues count per draft",
        "Percentages exclude known issues",
        "'Known Behaviors' section lists known issues by reason",
        "'Unexpected Failures' section lists actual bugs",
        "Typecheck passes"
      ],
      "passes": true,
      "notes": "Added Known column to summary table, Known Behaviors section per draft grouped by reason, renamed Failures to Unexpected Failures."
    },
    {
      "id": "US-007",
      "title": "Valibot known issues file",
      "description": "As a maintainer, I want valibot's known issues documented.",
      "acceptanceCriteria": [
        "Create typescript/packages/adapters/valibot/compliance/known-issues.json",
        "Copy zod's known-issues.json as starting point (shared limitations)",
        "Run compliance, identify valibot-specific failures",
        "Add entries for: JS prototype property names (__proto__, constructor, toString) if failing",
        "Re-run compliance - output shows known issues count",
        "No unexpected failures for documented README limitations",
        "Typecheck passes"
      ],
      "passes": true,
      "notes": "Added 50 JS prototype property tests, extended bundler/metaschema issues to draft7/6/4. All drafts now 100%."
    },
    {
      "id": "US-008",
      "title": "ArkType known issues file",
      "description": "As a maintainer, I want arktype's known issues documented.",
      "acceptanceCriteria": [
        "Create typescript/packages/adapters/arktype/compliance/known-issues.json",
        "Copy zod's known-issues.json as starting point (shared limitations)",
        "Run compliance, identify arktype-specific failures",
        "Add entries for: relative URI $id scoping, URN identifiers if failing",
        "Re-run compliance - output shows known issues count",
        "No unexpected failures for documented README limitations",
        "Typecheck passes"
      ],
      "passes": false,
      "notes": ""
    },
    {
      "id": "US-009",
      "title": "Effect known issues file",
      "description": "As a maintainer, I want effect's known issues documented.",
      "acceptanceCriteria": [
        "Create typescript/packages/adapters/effect/compliance/known-issues.json",
        "Copy zod's known-issues.json as starting point (shared limitations)",
        "Run compliance, identify effect-specific failures",
        "Re-run compliance - output shows known issues count",
        "No unexpected failures for documented README limitations",
        "Typecheck passes"
      ],
      "passes": false,
      "notes": ""
    }
  ]
}
