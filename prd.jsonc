{
	"project": "xschema adapters optimization",
	"description": "living execution plan: run adapter compliances, document limitations, and add new one-iteration implementation stories into this same prd.jsonc as discoveries clarify what’s worth doing (idiomatic, readable, performant).",
	"userStories": [
		{
			"id": "US-001",
			"title": "bootstrap discovery workflow",
			"description": "as a maintainer, i want a consistent discovery workflow so that ralph can iteratively add implementation stories into prd.jsonc without losing context between runs.",
			"acceptanceCriteria": [
				"create folder `tasks/adapters-optimization/`",
				"create `tasks/adapters-optimization/README.md` with: where discovery docs live, required discovery sections (baseline per draft + failing tests list), and the rule: after every discovery story, add 1–3 new one-iteration implementation stories into `prd.jsonc` directly after the discovery story, renumbering ids to stay sequential",
				"Typecheck passes"
			],
			"passes": true,
			"notes": ""
		},
		{
			"id": "US-002",
			"title": "core/ir discovery: lossless parsing + version semantics",
			"description": "as a maintainer, i want a concrete plan to make core parsing total (no keyword throws) and preserve unknown keywords so adapters can decide what to do.",
			"acceptanceCriteria": [
				"review current core parser/ir behavior for keyword-based throws and keyword loss",
				"write `tasks/adapters-optimization/core-discovery.md` with: baseline observations, list of keyword-based throws, proposal for preserving unknown/unsupported keywords (name + raw value + draft context), and minimal migration notes for adapters",
				"edit `prd.jsonc` to insert new one-iteration implementation stories (dependencies first) derived from `core-discovery.md`, directly after this story; renumber story ids to remain sequential",
				"Typecheck passes"
			],
			"passes": true,
			"notes": ""
		},
		{
			"id": "US-003",
			"title": "core: make parsing total (breaking api)",
			"description": "as a maintainer, i want core parsing to never throw so compliances can run end-to-end and adapters can choose how to handle unsupported keywords.",
			"acceptanceCriteria": [
				"change `parse()` to return `{ node, issues }` (breaking change)",
				"replace current throws for `unevaluatedItems`, `unevaluatedProperties`+applicators, and `$ref` resolution with captured issues + best-effort nodes",
				"update all adapters/callers to the new `parse()` signature",
				"Typecheck passes"
			],
			"passes": true,
			"notes": ""
		},
		{
			"id": "US-004",
			"title": "core: fail on unsupported keywords",
			"description": "as a maintainer, i want the core parser to fail on keywords that require evaluation semantics we can't provide (unevaluatedItems, unevaluatedProperties+applicators), since the bundler handles ref validation and adapters should not receive broken schemas.",
			"acceptanceCriteria": [
				"change core parse() to throw on unevaluatedItems presence",
				"change core parse() to throw on unevaluatedProperties when applicators are present",
				"change core parse() to throw on $dynamicRef, $dynamicAnchor, $recursiveRef, $recursiveAnchor",
				"Typecheck passes"
			],
			"passes": true,
			"notes": ""
		},
		{
			"id": "US-005",
			"title": "zod adapter discovery + baseline",
			"description": "as a maintainer, i want to understand zod compliance failures and which ones are idiomatic to fix so that we improve without forced emulation.",
			"acceptanceCriteria": [
				"run `bun run compliance` in `typescript/packages/adapters/zod/`",
				"write `tasks/adapters-optimization/zod-discovery.md` with: baseline per draft (pass %), full failing tests list per draft as `(keyword, group, test)`, categorized failures (core-missing/adapter-native/forced-emulation/not-supported), and expected regressions list",
				"edit `prd.jsonc` to insert new one-iteration implementation stories derived from `zod-discovery.md` (dependencies first), directly after this story; renumber story ids to remain sequential",
				"Typecheck passes"
			],
			"passes": true,
			"notes": "baseline: draft2020-12 92.8%, draft2019-09 92.1%, draft7 97.2%, draft6 96.9%, draft4 97.2%, draft3 95.9%. most failures are bundler limitations (dynamic refs, anchors, uri-encoding). zod adapter itself is solid."
		},
		{
			"id": "US-006",
			"title": "bundler: inject $schema for version detection",
			"description": "as a maintainer, i want the bundler to inject `$schema` based on draft when the input schema lacks one, so the ts core parser correctly normalizes draft3/4 boolean exclusiveMinimum/Maximum.",
			"acceptanceCriteria": [
				"compliance runner passes draft name to bundleSchema",
				"bundler injects `$schema` if missing (e.g., `http://json-schema.org/draft-04/schema#` for draft4)",
				"draft3/4 exclusiveMaximum/Minimum validation tests pass in zod compliance",
				"go build + go test ./... pass"
			],
			"passes": true,
			"notes": "derived from US-005. draft4: 98.6%→98.9% (+2 tests), draft3: 97.3%→97.8% (+2 tests)"
		},
		{
			"id": "US-007",
			"title": "bundler: URI-decode JSON pointer segments",
			"description": "as a maintainer, i want the bundler to properly decode URI-encoded segments in JSON pointers, so refs like `#/definitions/percent%25field` resolve correctly.",
			"acceptanceCriteria": [
				"bundler decodes percent-encoded segments when validating/resolving internal $refs",
				"escaped pointer ref tests pass (percent, slash, tilde, quote characters)",
				"go build + go test ./... pass"
			],
			"passes": true,
			"notes": "derived from US-005 zod-discovery. fixed 46 tests across all drafts (more than estimated 30 due to quote tests also passing)."
		},
		{
			"id": "US-008",
			"title": "bundler: resolve $anchor fragments",
			"description": "as a maintainer, i want the bundler to resolve `#anchor` style refs (location-independent identifiers) to their $anchor/$id declarations, so schemas using anchors work correctly.",
			"acceptanceCriteria": [
				"bundler collects $anchor declarations during first pass",
				"bundler resolves fragment-only refs like `#foo` to $anchor: foo locations",
				"location-independent identifier tests pass across drafts",
				"go build + go test ./... pass"
			],
			"passes": true,
			"notes": "derived from US-005 zod-discovery. fixed 10 tests: draft7 +4 (98.8%), draft6 +4 (98.7%), draft4 +2 (99.6%). all 'Location-independent identifier' tests now pass."
		},
		{
			"id": "US-009",
			"title": "valibot adapter discovery + baseline",
			"description": "as a maintainer, i want to understand valibot compliance failures and which ones are idiomatic to fix so that we improve without forced emulation.",
			"acceptanceCriteria": [
