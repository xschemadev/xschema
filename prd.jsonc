{
  "description": "Python xschema library cleanup: remove defaultNamespace, improve compliance, refactor parser to match TS structure, production-ready pyproject.toml, add useful comments",
  "status": "in_progress",
  "last_reviewed": "2026-01-26",
  "items": [
    // ============================================
    // CLEANUP: Remove cruft and orphaned files
    // ============================================
    {
      "id": "cleanup-harness-files",
      "category": "cleanup",
      "description": "Delete orphaned xschema-harness-*.py files from pydantic adapter and add to gitignore",
      "steps": [
        "delete all python/packages/adapters/pydantic/xschema-harness-*.py files",
        "add 'xschema-harness-*.py' pattern to python/.gitignore (create if needed)",
        "verify no harness files remain: ls python/packages/adapters/pydantic/xschema-harness-*.py returns empty"
      ],
      "passes": true,
      "notes": "These are temporary compliance test harness files that shouldn't be committed"
    },
    {
      "id": "cleanup-pycache",
      "category": "cleanup",
      "description": "Ensure __pycache__ and .pytest_cache are gitignored",
      "steps": [
        "check python/.gitignore exists and has __pycache__/, .pytest_cache/, *.pyc patterns",
        "if missing, add standard Python gitignore patterns",
        "remove any committed __pycache__ directories from git tracking"
      ],
      "passes": true,
      "notes": "Standard Python hygiene"
    },

    // ============================================
    // CLIENT: Remove defaultNamespace parameter
    // ============================================
    {
      "id": "client-remove-default-namespace",
      "category": "refactor",
      "description": "Remove default_namespace parameter from xschema-client - no type safety benefit in Python",
      "steps": [
        "edit python/packages/client/src/xschema_client/__init__.py",
        "remove default_namespace parameter from XSchemaClient.__init__",
        "remove default_namespace parameter from create_xschema_client function",
        "simplify __call__ to only accept full 'namespace:id' keys",
        "update docstrings to reflect the change",
        "update tests in python/packages/client/tests/test_client.py",
        "remove tests for shorthand lookups (test_shorthand_with_default_namespace, etc.)",
        "run 'uv run pytest packages/client' - must pass"
      ],
      "passes": true,
      "notes": "TypeScript has declaration merging for type safety. Python doesn't, so shorthand adds complexity without benefit."
    },
    {
      "id": "client-update-template",
      "category": "refactor",
      "description": "Update Python template to remove default_namespace from generated create_typed_client",
      "steps": [
        "edit cli/language/langs/python/templates.go",
        "remove default_namespace parameter from create_typed_client function",
        "update docstring and example in template",
        "regenerate python/example: run 'go run . generate --project ../python/example' from cli/",
        "verify python/example/_xschema/__init__.py has updated create_typed_client",
        "update python/example/main.py to not use default_namespace",
        "run 'uv run python main.py' from python/example - must work"
      ],
      "passes": true,
      "notes": "Keep template in sync with client library"
    },

    // ============================================
    // PARSER REFACTOR: Match TypeScript structure
    // ============================================
    {
      "id": "parser-split-primitives",
      "category": "refactor",
      "description": "Extract primitive type parsing to separate module (string, number, boolean, null)",
      "steps": [
        "create python/packages/core/src/xschema_core/parser/primitives.py",
        "move _parse_string and _parse_number functions from parser.py",
        "rename to parse_string and parse_number (public API)",
        "add type hints and docstrings explaining JSON Schema semantics",
        "add comments explaining draft4 vs draft6+ exclusiveMin/Max handling",
        "export from parser/__init__.py",
        "run 'uv run pytest packages/core' - must pass"
      ],
      "passes": true,
      "notes": "Follow TS structure: typescript/packages/core/src/parser/primitives.ts"
    },
    {
      "id": "parser-split-collections",
      "category": "refactor",
      "description": "Extract collection type parsing to separate module (array, object, tuple)",
      "steps": [
        "create python/packages/core/src/xschema_core/parser/collections.py",
        "move _parse_object, _parse_array, _parse_tuple, _parse_legacy_tuple functions",
        "rename to parse_object, parse_array, parse_tuple (public API)",
        "add detailed comments explaining prefixItems vs items semantics",
        "add comments explaining additionalItems vs items in legacy drafts",
        "add comments explaining patternProperties interaction with additionalProperties",
        "export from parser/__init__.py",
        "run 'uv run pytest packages/core' - must pass"
      ],
      "passes": true,
      "notes": "Follow TS structure: typescript/packages/core/src/parser/collections.ts"
    },
    {
      "id": "parser-split-composition",
      "category": "refactor",
      "description": "Extract composition keyword parsing to separate module (allOf, anyOf, oneOf, not, if/then/else)",
      "steps": [
        "create python/packages/core/src/xschema_core/parser/composition.py",
        "extract composition handling logic from _parse_with_ctx",
        "create parse_all_of, parse_any_of, parse_one_of, parse_not, parse_conditional functions",
        "add comments explaining allOf + anyOf + sibling keywords intersection behavior",
        "add comments explaining oneOf exactly-one semantics vs anyOf at-least-one",
        "export from parser/__init__.py",
        "run 'uv run pytest packages/core' - must pass"
      ],
      "passes": true,
      "notes": "Follow TS structure: typescript/packages/core/src/parser/composition.ts"
    },
    {
      "id": "parser-split-values",
      "category": "refactor",
      "description": "Extract value parsing to separate module (const, enum)",
      "steps": [
        "create python/packages/core/src/xschema_core/parser/values.py",
        "extract const and enum handling from _parse_with_ctx",
        "create parse_literal and parse_enum functions",
        "add comments explaining JSON Schema equality semantics (false != 0, true != 1)",
        "export from parser/__init__.py",
        "run 'uv run pytest packages/core' - must pass"
      ],
      "passes": true,
      "notes": "Follow TS structure: typescript/packages/core/src/parser/values.ts"
    },
    {
      "id": "parser-split-context",
      "category": "refactor",
      "description": "Extract parse context to separate module",
      "steps": [
        "create python/packages/core/src/xschema_core/parser/context.py",
        "move _ParseContext class",
        "rename to ParseContext (public class)",
        "add create_context factory function",
        "add comments explaining cycle detection for recursive refs",
        "export from parser/__init__.py",
        "run 'uv run pytest packages/core' - must pass"
      ],
      "passes": true,
      "notes": "Follow TS structure: typescript/packages/core/src/parser/context.ts"
    },
    {
      "id": "parser-create-package",
      "category": "refactor",
      "description": "Convert parser.py to parser/ package with clean __init__.py",
      "steps": [
        "create python/packages/core/src/xschema_core/parser/__init__.py",
        "export parse function as main public API",
        "export parseSchema for internal use by adapters if needed",
        "keep _resolve_json_pointer and _resolve_ref in index.py (or utils.py)",
        "delete old parser.py file",
        "update xschema_core/__init__.py imports",
        "run 'uv run pytest packages/core' - must pass",
        "run 'uv run pytest' - all 173 tests must pass"
      ],
      "passes": true,
      "notes": "Final step of parser refactor - clean up module structure"
    },

    // ============================================
    // COMPLIANCE: Fix remaining failures
    // ============================================
    {
      "id": "compliance-additionalprops-allof",
      "category": "functional",
      "description": "Fix additionalProperties not looking in allOf applicators",
      "steps": [
        "analyze failing test: 'properties defined in allOf are not examined'",
        "the issue: additionalProperties should only apply to properties NOT defined in ANY applicator (allOf, anyOf, oneOf)",
        "edit renderer.py to track properties from allOf when validating additionalProperties",
        "when additionalProperties=false + allOf, collect all property names from allOf branches",
        "run compliance on pydantic adapter",
        "verify 'additionalProperties does not look in applicators' test passes"
      ],
      "passes": true,
      "notes": "This is annotation tracking - need to know what properties were 'evaluated' by applicators"
    },
    {
      "id": "compliance-prefixitems-pseudo-array",
      "category": "functional",
      "description": "Fix JavaScript pseudo-array edge case in items/prefixItems",
      "steps": [
        "analyze failing test: 'JavaScript pseudo-array is valid'",
        "the test data is likely an object with numeric keys that looks like an array",
        "JSON Schema items only applies to actual arrays, not array-like objects",
        "verify renderer correctly checks isinstance(v, list) not just iterable",
        "run compliance on pydantic adapter",
        "verify items test passes"
      ],
      "passes": true,
      "notes": "Edge case where object with '0', '1' keys shouldn't be validated as array"
    },
    {
      "id": "compliance-unevaluated-basic",
      "category": "functional",
      "description": "Fix basic unevaluatedItems/unevaluatedProperties without applicators",
      "steps": [
        "analyze failing test: 'unevaluatedItems false', 'unevaluatedProperties false'",
        "these are simple cases without allOf/anyOf/oneOf - just items + unevaluatedItems",
        "unevaluatedItems should reject items beyond what items/prefixItems cover",
        "unevaluatedProperties should reject properties beyond what properties/patternProperties cover",
        "edit renderer.py to properly implement basic unevaluated* validation",
        "run compliance on pydantic adapter",
        "verify basic unevaluated tests pass"
      ],
      "passes": true,
      "notes": "Start with simple cases - no cross-applicator annotation tracking needed"
    },
    {
      "id": "compliance-unevaluated-adjacent",
      "category": "functional",
      "description": "Fix unevaluatedProperties with adjacent properties/patternProperties",
      "steps": [
        "analyze failing tests: 'unevaluatedProperties with adjacent properties'",
        "when properties and unevaluatedProperties are siblings, properties are 'evaluated'",
        "unevaluatedProperties should only check keys not in properties",
        "similar for patternProperties - keys matching patterns are 'evaluated'",
        "edit renderer.py to collect evaluated property names before checking unevaluated",
        "run compliance on pydantic adapter",
        "verify adjacent unevaluated tests pass"
      ],
      "passes": true,
      "notes": "Same-level annotation tracking is simpler than cross-applicator"
    },

    // ============================================
    // PYPROJECT.TOML: Production-ready metadata
    // ============================================
    {
      "id": "pyproject-core",
      "category": "architectural",
      "description": "Add complete production metadata to xschema-core pyproject.toml",
      "steps": [
        "edit python/packages/core/pyproject.toml",
        "add authors = [{name = 'xschemadev'}]",
        "add maintainers field",
        "add repository URL: https://github.com/xschemadev/xschema",
        "add documentation URL: https://xschema.dev",
        "add homepage URL",
        "add classifiers: Development Status, License, Intended Audience, Topic, Python versions",
        "add keywords: ['json-schema', 'validation', 'pydantic', 'code-generation']",
        "add license = {text = 'MIT'}",
        "verify uv can still build: run 'uv build' from packages/core"
      ],
      "passes": true,
      "notes": "Make package look professional on PyPI"
    },
    {
      "id": "pyproject-client",
      "category": "architectural",
      "description": "Add complete production metadata to xschema-client pyproject.toml",
      "steps": [
        "edit python/packages/client/pyproject.toml",
        "add same metadata as core package",
        "add license field",
        "add classifiers",
        "add keywords",
        "add URLs",
        "fix hatch build config if missing",
        "verify uv can build: run 'uv build' from packages/client"
      ],
      "passes": true,
      "notes": "Consistent metadata across all packages"
    },
    {
      "id": "pyproject-pydantic",
      "category": "architectural",
      "description": "Add complete production metadata to xschema-pydantic pyproject.toml",
      "steps": [
        "edit python/packages/adapters/pydantic/pyproject.toml",
        "add same metadata as other packages",
        "ensure pydantic>=2.0 constraint is explicit",
        "add annotated-types dependency if used",
        "add classifiers specific to this adapter",
        "verify uv can build: run 'uv build' from packages/adapters/pydantic"
      ],
      "passes": true,
      "notes": "Adapter-specific metadata"
    },
    {
      "id": "pyproject-workspace",
      "category": "architectural",
      "description": "Review and clean up workspace pyproject.toml",
      "steps": [
        "edit python/pyproject.toml",
        "ensure workspace members are correct",
        "add project-wide dev dependencies if needed (ruff for linting?)",
        "verify uv sync works from python/ directory"
      ],
      "passes": true,
      "notes": "Workspace root config"
    },

    // ============================================
    // COMMENTS: Add documentation
    // ============================================
    {
      "id": "comments-ir-types",
      "category": "cleanup",
      "description": "Add detailed comments to IR types explaining JSON Schema semantics",
      "steps": [
        "edit python/packages/core/src/xschema_core/ir.py",
        "add module docstring explaining what IR is and why it exists",
        "add comments to SchemaNode explaining the union of all node types",
        "add comments to ObjectNode explaining properties vs additionalProperties vs patternProperties",
        "add comments to ArrayNode explaining items vs prefixItems vs additionalItems across drafts",
        "add comments to IntersectionNode explaining allOf semantics",
        "add comments to OneOfNode explaining exactly-one vs anyOf at-least-one",
        "add comments to RefNode explaining why resolved can be None (cycles)",
        "add comments to TypeGuardedNode explaining typeless schemas with type-specific keywords"
      ],
      "passes": true,
      "notes": "IR types are the bridge between JSON Schema and generated code - need clear docs"
    },
    {
      "id": "comments-renderer",
      "category": "cleanup",
      "description": "Add detailed comments to renderer explaining Pydantic code generation strategies",
      "steps": [
        "edit python/packages/adapters/pydantic/src/xschema_pydantic/renderer.py",
        "add module docstring explaining the rendering approach",
        "add comments to render_number explaining StrictInt vs StrictFloat choice",
        "add comments to render_literal explaining why booleans need special handling (Python 0==False)",
        "add comments to render_enum explaining _json_equals helper for deep equality",
        "add comments to render_object explaining ConfigDict extra='forbid' vs 'allow'",
        "add comments to render_union explaining discriminated union detection",
        "add comments to render_intersection explaining object merging strategy",
        "add comments to render_oneof explaining exactly-one validation approach",
        "add comments explaining helper function registry pattern"
      ],
      "passes": true,
      "notes": "Renderer has many non-obvious decisions - document the why"
    },
    {
      "id": "comments-converter",
      "category": "cleanup",
      "description": "Add comments to converter explaining the parse->render pipeline",
      "steps": [
        "edit python/packages/adapters/pydantic/src/xschema_pydantic/converter.py",
        "add module docstring explaining converter's role",
        "add comments to _is_object_only_schema explaining JSON Schema type inference",
        "add comments explaining type guard wrapper generation",
        "add comments explaining TypeAdapter usage for all schemas"
      ],
      "passes": true,
      "notes": "Converter orchestrates the pipeline - document flow"
    },
    {
      "id": "comments-client",
      "category": "cleanup",
      "description": "Add comments to client explaining runtime lookup design",
      "steps": [
        "edit python/packages/client/src/xschema_client/__init__.py",
        "add module docstring explaining client's purpose",
        "add comments explaining why namespace:id format was chosen",
        "add comments explaining XSchemaError for user-friendly messages"
      ],
      "passes": true,
      "notes": "Simple module but design decisions should be documented"
    },

    // ============================================
    // FINAL VERIFICATION
    // ============================================
    {
      "id": "verify-tests",
      "category": "test",
      "description": "Verify all tests pass after changes",
      "steps": [
        "run 'uv run pytest' from python/ directory",
        "all tests must pass",
        "run 'uv run mypy packages/' from python/ directory",
        "no type errors allowed"
      ],
      "passes": true,
      "notes": "Sanity check after all changes"
    },
    {
      "id": "verify-compliance",
      "category": "test",
      "description": "Run final compliance check and document results",
      "steps": [
        "run compliance on pydantic adapter",
        "document final pass rates for each draft",
        "update compliance/results/REPORT.md with final numbers",
        "ensure no regressions from starting point"
      ],
      "passes": true,
      "notes": "Compliance is the ultimate test of correctness"
    },
    {
      "id": "verify-example",
      "category": "test",
      "description": "Verify example project works end-to-end",
      "steps": [
        "regenerate example: run 'go run . generate --project ../python/example' from cli/",
        "run 'uv run python main.py' from python/example",
        "verify output shows successful validation",
        "verify no type: ignore comments needed in main.py"
      ],
      "passes": false,
      "notes": "Example is the user's first impression"
