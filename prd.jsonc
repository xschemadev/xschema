{
	"project": "xschema",
	"branchName": "ralph/universal-harness",
	"description": "Universal Compliance Harness - Replace per-adapter harness files with one template per language (and standardize TS import merging across imports + validateImports)",
	"userStories": [
		{
			"id": "US-001",
			"title": "Add Validate field to AdapterOutput",
			"description": "As the compliance runner, I need adapters to provide a validate function so the harness knows how to validate data.",
			"acceptanceCriteria": [
				"Add Validate string field to AdapterOutput struct in cli/compliance/types.go",
				"Add ValidateImports []string field for imports needed by validate function (optional)",
				"Validate contains function in target language syntax",
				"Function signature: takes data, returns bool, can reference schema variable",
				"Empty Validate = type-only adapter (skip runtime validation)",
				"Typecheck passes"
			],
			"passes": true,
			"notes": ""
		},
		{
			"id": "US-002",
			"title": "Create TypeScript harness template",
			"description": "As the compliance system, I need a single TS harness template that works for all TypeScript adapters.",
			"acceptanceCriteria": [
				"Uses Go text/template (same pattern as existing language templates in cli/language/)",
				"Outputs JSON array to stdout (same format as current harness)",
				"Handles type-only adapters (empty Validate results in all skipped)",
				"Write Go tests for template rendering",
				"Typecheck passes"
			],
			"passes": true,
			"notes": "Template renders full import statements and appends semicolons; tests cover imports-only + validateImports-only; import merging/dedupe will be handled by US-012."
		},
		{
			"id": "US-003",
			"title": "Update GenerateTempHarness to use templates",
			"description": "As the compliance runner, I need GenerateTempHarness to use Go text/template instead of string replacement.",
			"acceptanceCriteria": [
				"Use template.Execute instead of strings.ReplaceAll",
				"Select template based on language",
				"Existing compliance tests pass",
				"Write thoughtful Go tests for new template generation logic",
				"Typecheck passes"
			],
			"passes": true,
			"notes": ""
		},
		{
			"id": "US-004",
			"title": "Update zod adapter to return validate",
			"description": "As the harness generator, I need the zod adapter to provide its validate function.",
			"acceptanceCriteria": [
				"Adapter returns validate function: (data) => schema.safeParse(data).success",
				"Adapter does not require validateImports (safeParse is method on schema)",
				"Adapter passes compliance tests with new harness",
				"Typecheck passes"
			],
			"passes": true,
			"notes": ""
		},
		{
			"id": "US-005",
			"title": "Update arktype adapter to return validate",
			"description": "As the harness generator, I need the arktype adapter to provide its validate function.",
			"acceptanceCriteria": [
				"Adapter returns validate function with appropriate arktype validation logic",
				"Adapter returns validateImports if needed",
				"Adapter passes compliance tests with new harness",
				"Typecheck passes"
			],
			"passes": true,
			"notes": ""
		},
		{
			"id": "US-006",
			"title": "Update valibot adapter to return validate",
			"description": "As the harness generator, I need the valibot adapter to provide its validate function.",
			"acceptanceCriteria": [
				"Adapter returns validate function using safeParse",
				"Adapter returns validateImports for safeParse import",
				"Adapter passes compliance tests with new harness",
				"Typecheck passes"
			],
			"passes": true,
			"notes": "Scoped compliance: draft2020-12/type 79/80 (98.8%)."
		},

		{
			"id": "US-007",
			"title": "Update typebox adapter to return validate",
			"description": "As the harness generator, I need the typebox adapter to provide its validate function.",
			"acceptanceCriteria": [
				"Adapter returns validate function using Value.Check",
				"Adapter includes any Value imports needed by validate (same format as imports)",
				"Adapter passes compliance tests with new harness",
				"Typecheck passes"
			],
			"passes": true,
			"notes": "Typebox now emits full import statements and validate uses Value.Check(schema, data)."
		},
		{
			"id": "US-008",
			"title": "Update effect adapter to return validate",
			"description": "As the harness generator, I need the effect adapter to provide its validate function.",
			"acceptanceCriteria": [
				"Adapter returns validate function with appropriate effect validation logic",
				"Adapter includes any imports needed by validate (same format as imports)",
				"Adapter passes compliance tests with new harness",
				"Typecheck passes"
			],
			"passes": false,
			"notes": "Effect adapter still needs to implement validate + any validateImports (and pass compliance with the TS harness)."
		},
		{
			"id": "US-009",
			"title": "Update typescript adapter for type-only mode",
			"description": "As the harness generator, I need the typescript type-only adapter to return empty validate.",
			"acceptanceCriteria": [
				"Adapter returns empty validate string",
				"Adapter returns empty validateImports (or omits it)",
				"Adapter passes compliance tests (all results should be skipped)",
				"Typecheck passes"
			],
			"passes": false,
			"notes": "Type-only harness currently uses AdapterOutput.Schema; typescript adapter returns schema empty and type in AdapterOutput.Type, so the harness generation path needs adjustment."
		},

		{
			"id": "US-010",
			"title": "Remove per-adapter harness files",
			"description": "As a maintainer, I want to remove duplicate harness files now that we have a universal template.",
			"acceptanceCriteria": [
				"Delete all typescript/packages/adapters/*/compliance/harness.ts files",
				"Update cli/cmd/compliance.go to not require a per-adapter harness file to exist",
				"Remove or repurpose FindHarness logic once nothing relies on harness.* presence",
				"Verify no other code references deleted files (web app, shared scripts, docs)",
				"All compliance tests pass",
				"Full relevant test suite passes (no regressions)",
				"Typecheck passes"
			],
			"passes": false,
			"notes": "Runner generates harness from templates, but CLI still checks for compliance/harness.* today. This story makes the universal harness truly universal."
		},

		{
			"id": "US-011",
			"title": "Standardize TS adapter import output format",
			"description": "As the generator and compliance harness, I need TypeScript adapters to emit imports and validateImports in the same canonical format so they can be merged deterministically.",
			"acceptanceCriteria": [
				"Canonical format: each entry in imports/validateImports is a full TS import statement without trailing semicolon (e.g. import { z } from \"zod\")",
				"validateImports uses the exact same format as imports",
				"Update all TS adapters to follow the canonical format (zod, arktype, valibot, typebox, effect, typescript)",
				"bun run build + bun run typecheck passes"
			],
			"passes": true,
			"notes": "Adapters now emit full import statements; follow-up work is in US-013 (MergeTSImports) + US-012 (harness merging)."
		},
		{
			"id": "US-012",
			"title": "Merge imports + validateImports for TS harness",
			"description": "As the compliance runner, I want the generated TS harness to merge imports and validateImports using the same rules as the normal generator output.",
			"acceptanceCriteria": [
				"GenerateTempHarness merges adapterOutput.Imports + adapterOutput.ValidateImports into one slice",
				"Merged slice is formatted via the TypeScript language import merger (cli/language/MergeTSImports)",
				"TSHarnessTemplate renders the already-merged import block once (same pattern as cli/language/templates.go)",
				"No duplicate imports in generated harness when imports overlap",
				"Update harness template tests to assert deterministic merged output",
				"Go tests pass"
			],
			"passes": false,
			"notes": "Harness template now accepts full import statements; this story adds MergeTSImports-based merging/dedupe across Imports + ValidateImports."
		},
		{
			"id": "US-013",
			"title": "Make MergeTSImports support real-world TS import forms",
			"description": "As a maintainer, I need MergeTSImports to handle the import statements adapters actually produce (including namespace and type-only imports) so both generator and harness output are stable.",
			"acceptanceCriteria": [
				"Handle named imports: import { A, type B } from \"x\"",
				"Handle type-only named imports: import type { A } from \"x\"",
				"Handle namespace imports: import * as v from \"x\" (must not be merged with named imports from same source)",
				"Handle side-effect imports: import \"x\"",
				"Maintain deterministic ordering and dedupe",
				"Add/extend unit tests in cli/language/imports_test.go",
				"Go tests pass"
			],
			"passes": false,
			"notes": "Currently MergeTSImports drops namespace imports like `import * as v from \"valibot\"`; fix + test coverage needed for generator and harness merging."
		},
		{
			"id": "US-014",
			"title": "Align docs and developer guidance with canonical imports",
			"description": "As a contributor, I want docs to accurately describe the adapter protocol for imports and validateImports so new adapters don’t reintroduce mismatches.",
			"acceptanceCriteria": [
				"Update docs/adapter-system.md to show canonical imports format (full import statements)",
				"Update typescript/AGENTS.md adapter protocol example if needed",
				"Update any notes that claim 'template adds import prefix'",
				"No conflicting guidance between docs and code"
			],
			"passes": false,
			"notes": "Docs still need to describe `validate` + `validateImports` fields and any remaining guidance about harness import handling."
		}
	]
}
