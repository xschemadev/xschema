{
  "project": "xschema",
  "description": "go cli language system refactor: typescript-only, multi-file outputs, adapter refs, and synced web json schemas",
  "userStories": [
    {
      "id": "US-001",
      "title": "add xschema.adapter.json metadata to adapters",
      "description": "As a maintainer, I want each adapter directory to declare its canonical adapter ref so that tooling can discover adapters without guessing from path names.",
      "acceptanceCriteria": [
        "Add `xschema.adapter.json` to each existing adapter directory under `typescript/packages/adapters/*`",
        "Each `xschema.adapter.json` contains at least `{ \"ref\": \"@xschemadev/<adapter>\" }`",
        "No duplicate `ref` values across adapters",
        "Typecheck passes"
      ],
      "passes": false,
      "notes": ""
    },
    {
      "id": "US-002",
      "title": "update web schema generator to use xschema.adapter.json refs",
      "description": "As a user, I want IDE json schema validation to autocomplete adapter refs in the same format the cli expects, so configs don’t validate in the editor but fail at runtime.",
      "acceptanceCriteria": [
        "Update `web/scripts/generate-schemas.ts` to read adapter refs from `xschema.adapter.json` (not directory names or package.json)",
        "If any adapter is missing `xschema.adapter.json`, has invalid json, lacks `ref`, or duplicates a `ref`, the script exits with a clear error",
        "Generated `web/public/schemas/typescript.jsonc` uses adapter enums like `@xschemadev/zod` (not `zod`)",
        "Run `bun run types:check` from `web/` successfully",
        "Typecheck passes"
      ],
      "passes": false,
      "notes": ""
    },
    {
      "id": "US-003",
      "title": "introduce language spec types for invokers and emitters",
      "description": "As a maintainer, I want a small language spec layer so the cli can support many languages without a single giant struct full of optional fields.",
      "acceptanceCriteria": [
        "Add language core types for multi-file outputs (e.g. `GeneratedFile{Path, Contents}`)",
        "Add capability interfaces for adapter invocation (command spec) and file emission",
        "Add shared validators/helpers for safe relative paths and deterministic ordering",
        "Go checks pass: `go test ./...` and `go vet ./...` (from `cli/`)",
        "Typecheck passes"
      ],
      "passes": false,
      "notes": ""
    },
    {
      "id": "US-004",
      "title": "add language registry with validation and test reset",
      "description": "As a maintainer, I want a validated language registry so languages can be registered once and looked up consistently by name and schema url.",
      "acceptanceCriteria": [
        "Implement registry api: Register, ByName, BySchemaURL, AllIgnoreDirs, SupportedLanguages",
        "Registry rejects duplicate names and duplicate schema url mappings with clear errors",
        "Add `ResetForTests()` (or equivalent) to prevent global state leakage between tests",
        "Add contract tests covering registration validation and lookups",
        "Go checks pass: `go test ./...` and `go vet ./...` (from `cli/`)",
        "Typecheck passes"
      ],
      "passes": false,
      "notes": ""
    },
    {
      "id": "US-005",
      "title": "move typescript language into per-language folder and register it",
      "description": "As a contributor, I want typescript language support isolated in one folder so adding another language is a copyable pattern.",
      "acceptanceCriteria": [
        "Move TypeScript language implementation into `cli/language/langs/typescript/` and register it via the registry",
        "Keep the stable import path `github.com/xschemadev/xschema/language` for other cli packages",
        "Ensure language lookup works for `$schema: https://xschema.dev/schemas/typescript.jsonc`",
        "Go checks pass: `go test ./...` and `go vet ./...` (from `cli/`)",
        "Typecheck passes"
      ],
      "passes": false,
      "notes": ""
    },
    {
      "id": "US-006",
      "title": "remove python language support and keep multi-language tests via fake language",
      "description": "As a maintainer, I want to remove unfinished python support so the repo doesn’t claim features that don’t work, while keeping test coverage for multi-language detection.",
      "acceptanceCriteria": [
        "Remove python language implementation and registration",
        "Update docs/strings in cli commands so `--lang python` errors as unknown language",
        "Update parser tests that used python to instead register a test-only fake language and assert multi-language conflict behavior",
        "Go checks pass: `go test ./...` and `go vet ./...` (from `cli/`)",
        "Typecheck passes"
      ],
      "passes": false,
      "notes": ""
    },
    {
      "id": "US-007",
      "title": "refactor generator to use language adapter invoker and adapter refs",
      "description": "As a user, I want adapter invocation to be language-defined so the cli doesn’t hardcode node-specific runner assumptions and can support other languages.",
      "acceptanceCriteria": [
        "Replace generator’s hardcoded runner/bin logic with a call to the language’s AdapterInvoker returning a full command spec",
        "TypeScript invoker validates adapter refs are scoped npm package refs (e.g. `@xschemadev/zod`) and errors with migration guidance for legacy `\"zod\"`",
        "TypeScript invoker derives adapter cli as `xschema-<package-basename>` and runs it from project root (runner detection relative to project root)",
        "Go checks pass: `go test ./...` and `go vet ./...` (from `cli/`)",
        "Typecheck passes"
      ],
      "passes": false,
      "notes": ""
    },
    {
      "id": "US-008",
      "title": "refactor injector for multi-file outputs with safe paths",
      "description": "As a maintainer, I want injector to support multi-file outputs so future languages can generate idiomatic layouts instead of being forced into one file.",
      "acceptanceCriteria": [
        "Update injector to accept `[]GeneratedFile` and write all files under `--output` root",
        "Reject emitted paths that are absolute, contain `..`, or collide with another emitted path",
        "Writes are deterministic (stable ordering by path)",
        "Go checks pass: `go test ./...` and `go vet ./...` (from `cli/`)",
        "Typecheck passes"
      ],
      "passes": false,
      "notes": ""
    },
    {
      "id": "US-009",
      "title": "add fixed-name manifest and stale file cleanup",
      "description": "As a user, I want stale generated files removed automatically so multi-file outputs don’t accumulate garbage and break builds.",
      "acceptanceCriteria": [
        "Write a manifest at `--output/xschema.manifest.json` listing generated file paths",
        "On subsequent runs, delete only files present in the old manifest but not in the new manifest (and only within `--output`)",
        "Manifest write is atomic (temp + rename)",
        "Go checks pass: `go test ./...` and `go vet ./...` (from `cli/`)",
        "Typecheck passes"
      ],
      "passes": false,
      "notes": ""
    },
    {
      "id": "US-010",
      "title": "docs cleanup for language system and adapter refs",
      "description": "As a contributor, I want documentation to match the actual language system so adding a language doesn’t require reading outdated notes.",
      "acceptanceCriteria": [
