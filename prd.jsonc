{
	"description": "Create TypeScript adapters for Valibot, Effect/Schema, TypeBox, and native TypeScript types. Enhance compliance harness to run typecheck on all generated code.",
	"items": [
		// ============================================
		// VALIBOT ADAPTER
		// ============================================
		{
			"id": "valibot-scaffold",
			"category": "functional",
			"description": "Create Valibot adapter package. Follow the exact structure of packages/adapters/zod: package.json with peer dependency on valibot, src/index.ts with convert function, src/cli.ts with stdin/stdout protocol, src/renderer.ts skeleton, tsconfig.json, and compliance directory structure.",
			"steps": [
				"verify packages/adapters/valibot/ directory exists",
				"run: bun run build (from typescript/)",
				"verify build succeeds without errors"
			],
			"passes": true,
			"notes": "Follow zod adapter pattern exactly - see packages/adapters/zod/ for reference"
		},
		{
			"id": "valibot-harness",
			"category": "integration",
			"description": "Create compliance harness at compliance/harness.ts. The harness is a template that receives {{GENERATED_CODE}} and {{TEST_CASES_STRING}} placeholders. It should import valibot, create the schema, run test cases through safeParse (or valibot equivalent), and output JSON results.",
			"steps": [
				"run: xschema compliance --dev-report (from packages/adapters/valibot/)",
				"verify command completes without crashing",
				"verify compliance/results/REPORT.md is generated"
			],
			"passes": true,
			"notes": "See packages/adapters/zod/compliance/harness.ts for exact pattern"
		},
		{
			"id": "valibot-renderer-primitives",
			"category": "functional",
			"description": "Implement renderer for primitive types in src/renderer.ts. Handle string (with minLength, maxLength, pattern, format), number (with minimum, maximum, exclusiveMinimum, exclusiveMaximum, multipleOf, integer), boolean, and null. Use valibot's native methods where available, fall back to custom refinements for constraints valibot doesn't support natively.",
			"steps": [
				"run: xschema compliance --dev-report (from packages/adapters/valibot/)",
				"verify 'type' keyword tests pass for string, number, boolean, null",
				"verify 'minLength', 'maxLength', 'pattern' tests pass",
				"verify 'minimum', 'maximum', 'multipleOf' tests pass",
				"run: bun run typecheck (from typescript/) - verify no type errors"
			],
			"passes": true,
			"notes": "JSON Schema minLength/maxLength count grapheme clusters, not code points - see zod adapter's Intl.Segmenter approach"
		},
		{
			"id": "valibot-renderer-containers",
			"category": "functional",
			"description": "Implement renderer for container types. Handle object (properties, required, additionalProperties, patternProperties, propertyNames, minProperties, maxProperties, dependencies), array (items, minItems, maxItems, uniqueItems, contains), and tuple (prefixItems, items/additionalItems).",
			"steps": [
				"run: xschema compliance --dev-report (from packages/adapters/valibot/)",
				"verify 'properties', 'required', 'additionalProperties' tests pass",
				"verify 'items', 'minItems', 'maxItems', 'uniqueItems' tests pass",
				"verify 'prefixItems' and tuple tests pass",
				"run: bun run typecheck (from typescript/) - verify no type errors"
			],
			"passes": true
		},
		{
			"id": "valibot-renderer-combinators",
			"category": "functional",
			"description": "Implement renderer for combinator types. Handle anyOf (union), allOf (intersection), oneOf (exactly one match - requires validation logic), and not (negation).",
			"steps": [
				"run: xschema compliance --dev-report (from packages/adapters/valibot/)",
				"verify 'anyOf', 'allOf', 'oneOf', 'not' tests pass",
				"run: bun run typecheck (from typescript/) - verify no type errors"
			],
			"passes": true,
			"notes": "oneOf requires counting matches and rejecting if != 1"
		},
		{
			"id": "valibot-renderer-special",
			"category": "functional",
			"description": "Implement renderer for special types. Handle const (literal values including objects/arrays with deep equality), enum (multiple allowed values), $ref (already resolved in IR - just render the resolved node), if/then/else (conditional validation), nullable, any, and never.",
			"steps": [
				"run: xschema compliance --dev-report (from packages/adapters/valibot/)",
				"verify 'const', 'enum' tests pass",
				"verify '$ref' tests pass",
				"verify 'if', 'then', 'else' tests pass",
				"run: bun run typecheck (from typescript/) - verify no type errors"
			],
			"passes": false,
			"notes": "RefNode.resolved already contains the parsed schema - just render it recursively"
		},
		{
			"id": "valibot-compliance-complete",
			"category": "integration",
			"description": "Run full compliance suite, analyze failures, fix all issues that are fixable within valibot's capabilities. For issues that cannot be fixed due to valibot limitations, document them clearly.",
			"steps": [
				"run: xschema compliance --dev-report (from packages/adapters/valibot/)",
				"review REPORT.md for any failures not related to known limitations",
				"verify all fixable issues are resolved",
				"verify remaining failures are documented in README"
			],
			"passes": false,
			"notes": "Expected limitations: $dynamicRef, unevaluatedProperties with applicators - see zod README for patterns"
		},
		{
			"id": "valibot-readme",
			"category": "cleanup",
			"description": "Create README.md following the structure of packages/adapters/zod/README.md. Include: compliance link, Known Limitations section with detailed explanations for each limitation, Installation, Usage example with xschema config.",
			"steps": [
				"verify README.md exists with Known Limitations section",
				"verify each limitation has explanation and workaround",
				"verify usage example shows xschema config and generated output"
			],
			"passes": false
		},
		{
			"id": "valibot-docs",
			"category": "cleanup",
			"description": "Create remaining documentation: CHANGELOG.md (can be minimal for initial release), ensure compliance/results/ has all generated JSON and REPORT.md files.",
			"steps": [
				"verify CHANGELOG.md exists",
				"verify compliance/results/REPORT.md exists",
				"verify compliance/results/*.json files exist for each draft version"
			],
			"passes": false
		},
		// ============================================
		// EFFECT/SCHEMA ADAPTER
		// ============================================
		{
			"id": "effect-scaffold",
			"category": "functional",
			"description": "Create Effect/Schema adapter package. Follow the exact structure of packages/adapters/zod.",
			"steps": [
				"verify packages/adapters/effect/ directory exists",
				"run: bun run build (from typescript/)",
				"verify build succeeds without errors"
			],
			"passes": false
		},
		{
			"id": "effect-harness",
			"category": "integration",
			"description": "Create compliance harness at compliance/harness.ts.",
			"steps": [
				"run: xschema compliance --dev-report (from packages/adapters/effect/)",
				"verify command completes without crashing",
				"verify compliance/results/REPORT.md is generated"
			],
			"passes": false
		},
		{
			"id": "effect-renderer-primitives",
			"category": "functional",
			"description": "Implement renderer for primitive types. Handle string with constraints, number with constraints, boolean, null.",
			"steps": [
				"run: xschema compliance --dev-report (from packages/adapters/effect/)",
				"verify 'type' keyword tests pass for string, number, boolean, null",
				"verify string constraint tests pass (minLength, maxLength, pattern)",
				"verify number constraint tests pass (minimum, maximum, multipleOf)",
				"run: bun run typecheck (from typescript/) - verify no type errors"
			],
			"passes": false
		},
		{
			"id": "effect-renderer-containers",
			"category": "functional",
			"description": "Implement renderer for container types. Handle objects, arrays, tuples with optional properties and additional properties validation.",
			"steps": [
				"run: xschema compliance --dev-report (from packages/adapters/effect/)",
				"verify object, array, tuple keyword tests pass",
				"run: bun run typecheck (from typescript/) - verify no type errors"
			],
			"passes": false
		},
		{
			"id": "effect-renderer-combinators",
			"category": "functional",
			"description": "Implement renderer for combinator types. Handle anyOf, allOf, oneOf, not.",
			"steps": [
				"run: xschema compliance --dev-report (from packages/adapters/effect/)",
				"verify 'anyOf', 'allOf', 'oneOf', 'not' tests pass",
				"run: bun run typecheck (from typescript/) - verify no type errors"
			],
			"passes": false
		},
		{
			"id": "effect-renderer-special",
			"category": "functional",
			"description": "Implement renderer for special types. Handle const, enum, $ref, if/then/else, nullable, any, never.",
			"steps": [
				"run: xschema compliance --dev-report (from packages/adapters/effect/)",
				"verify 'const', 'enum', '$ref', 'if/then/else' tests pass",
				"run: bun run typecheck (from typescript/) - verify no type errors"
			],
			"passes": false
		},
		{
			"id": "effect-compliance-complete",
			"category": "integration",
			"description": "Run full compliance suite, analyze failures, fix all fixable issues. Document Effect Schema-specific limitations.",
			"steps": [
				"run: xschema compliance --dev-report (from packages/adapters/effect/)",
				"review REPORT.md for any failures not related to known limitations",
				"verify all fixable issues are resolved",
				"verify remaining failures are documented in README"
			],
			"passes": false
		},
		{
			"id": "effect-readme",
			"category": "cleanup",
			"description": "Create README.md following the structure of packages/adapters/zod/README.md. Document Effect Schema-specific limitations and workarounds.",
			"steps": [
				"verify README.md exists with Known Limitations section",
				"verify usage example shows xschema config and generated output"
			],
			"passes": false
		},
		{
			"id": "effect-docs",
			"category": "cleanup",
			"description": "Create remaining documentation: CHANGELOG.md, ensure compliance/results/ has all generated files.",
			"steps": [
				"verify CHANGELOG.md exists",
				"verify compliance/results/REPORT.md exists",
				"verify compliance/results/*.json files exist"
			],
			"passes": false
		},
		// ============================================
		// TYPEBOX ADAPTER
		// ============================================
		{
			"id": "typebox-scaffold",
			"category": "functional",
			"description": "Create TypeBox adapter package. Follow the exact structure of packages/adapters/zod. Peer dependency on @sinclair/typebox.",
			"steps": [
				"verify packages/adapters/typebox/ directory exists",
				"run: bun run build (from typescript/)",
				"verify build succeeds without errors"
			],
			"passes": false,
			"notes": "TypeBox was designed for JSON Schema compatibility - expect high compliance"
		},
		{
			"id": "typebox-harness",
			"category": "integration",
			"description": "Create compliance harness at compliance/harness.ts.",
			"steps": [
				"run: xschema compliance --dev-report (from packages/adapters/typebox/)",
				"verify command completes without crashing",
				"verify compliance/results/REPORT.md is generated"
			],
			"passes": false
		},
		{
			"id": "typebox-renderer-primitives",
			"category": "functional",
			"description": "Implement renderer for primitive types. Handle string, number, boolean, null with their constraints.",
			"steps": [
				"run: xschema compliance --dev-report (from packages/adapters/typebox/)",
				"verify 'type' keyword tests pass",
				"verify string and number constraint tests pass",
				"run: bun run typecheck (from typescript/) - verify no type errors"
			],
			"passes": false
		},
		{
			"id": "typebox-renderer-containers",
			"category": "functional",
			"description": "Implement renderer for container types. Handle objects, arrays, tuples with additionalProperties, etc.",
			"steps": [
				"run: xschema compliance --dev-report (from packages/adapters/typebox/)",
				"verify object, array, tuple keyword tests pass",
				"run: bun run typecheck (from typescript/) - verify no type errors"
			],
			"passes": false
		},
		{
			"id": "typebox-renderer-combinators",
			"category": "functional",
			"description": "Implement renderer for combinator types. Handle anyOf, allOf, oneOf, not.",
			"steps": [
				"run: xschema compliance --dev-report (from packages/adapters/typebox/)",
				"verify 'anyOf', 'allOf', 'oneOf', 'not' tests pass",
				"run: bun run typecheck (from typescript/) - verify no type errors"
			],
			"passes": false
		},
		{
			"id": "typebox-renderer-special",
			"category": "functional",
			"description": "Implement renderer for special types. Handle const, enum, $ref, if/then/else, nullable, any, never.",
			"steps": [
				"run: xschema compliance --dev-report (from packages/adapters/typebox/)",
				"verify 'const', 'enum', '$ref', 'if/then/else' tests pass",
				"run: bun run typecheck (from typescript/) - verify no type errors"
			],
			"passes": false
		},
		{
			"id": "typebox-compliance-complete",
			"category": "integration",
			"description": "Run full compliance suite. TypeBox should have very high compliance since it was designed for JSON Schema. Document any limitations.",
			"steps": [
				"run: xschema compliance --dev-report (from packages/adapters/typebox/)",
				"review REPORT.md - expect very high pass rate",
				"verify any failures are documented in README"
			],
			"passes": false
		},
		{
			"id": "typebox-readme",
			"category": "cleanup",
			"description": "Create README.md following the structure of packages/adapters/zod/README.md.",
			"steps": [
				"verify README.md exists",
				"verify usage example shows xschema config and generated output"
			],
			"passes": false
		},
		{
			"id": "typebox-docs",
			"category": "cleanup",
			"description": "Create remaining documentation: CHANGELOG.md, ensure compliance/results/ has all generated files.",
			"steps": [
				"verify CHANGELOG.md exists",
				"verify compliance/results/REPORT.md exists",
				"verify compliance/results/*.json files exist"
			],
			"passes": false
		},
		// ============================================
		// TYPESCRIPT (TYPE-ONLY) ADAPTER
		// ============================================
		{
			"id": "typescript-scaffold",
			"category": "functional",
			"description": "Create TypeScript type-only adapter package. This adapter generates TypeScript type definitions only - NO runtime validation code. Follow packages/adapters/zod structure but without any peer dependencies (no runtime library needed).",
			"steps": [
				"verify packages/adapters/typescript/ directory exists",
				"run: bun run build (from typescript/)",
				"verify build succeeds without errors"
			],
			"passes": false,
			"notes": "Type-only: result.schema should be empty, result.type contains the TS type expression"
		},
		{
			"id": "typescript-renderer-primitives",
			"category": "functional",
			"description": "Implement type renderer for primitive types. string -> 'string', number -> 'number', boolean -> 'boolean', null -> 'null'. Runtime constraints (minLength, pattern, minimum, etc.) cannot be expressed in TypeScript types - ignore them.",
			"steps": [
				"verify string/number/boolean/null schemas render to correct TS primitive type names",
				"run: bun run typecheck (from typescript/) - verify no type errors"
			],
			"passes": false,
			"notes": "Constraints are NOT expressible in TS types - document this clearly"
		},
		{
			"id": "typescript-renderer-containers",
			"category": "functional",
			"description": "Implement type renderer for container types. Objects render to TS object types with optional properties (prop?: type), arrays render to Array<T> or T[], tuples render to TS tuple types [T1, T2, ...].",
			"steps": [
				"verify object schemas render to { prop: type; optProp?: type }",
				"verify array schemas render to Array<T>",
				"verify tuple schemas render to [T1, T2, ...rest: T3[]]",
				"run: bun run typecheck (from typescript/) - verify no type errors"
			],
			"passes": false
		},
		{
			"id": "typescript-renderer-combinators",
			"category": "functional",
			"description": "Implement type renderer for combinator types. anyOf renders to union (T1 | T2), allOf renders to intersection (T1 & T2), oneOf renders same as union (no runtime distinction in types), not cannot be expressed.",
			"steps": [
				"verify anyOf renders to T1 | T2 | T3",
				"verify allOf renders to T1 & T2 & T3",
				"verify oneOf renders to union (same as anyOf)",
				"run: bun run typecheck (from typescript/) - verify no type errors"
			],
			"passes": false,
			"notes": "'not' cannot be expressed in TS types - render as 'unknown' or document"
		},
		{
			"id": "typescript-renderer-special",
			"category": "functional",
			"description": "Implement type renderer for special types. const renders to literal type, enum renders to union of literals, $ref renders the resolved type, nullable renders as T | null, any renders as 'unknown' or 'any', never renders as 'never'.",
			"steps": [
				"verify const: 'hello' renders to 'hello' (literal type)",
				"verify enum: ['a', 'b'] renders to 'a' | 'b'",
				"verify nullable renders to T | null",
				"run: bun run typecheck (from typescript/) - verify no type errors"
			],
			"passes": false
		},
		{
			"id": "typescript-convert-output",
			"category": "functional",
			"description": "Verify the convert function returns correct ConvertResult structure for type-only output. result.schema should be empty string (no runtime code), result.type should contain the TypeScript type expression, result.imports should be empty array.",
			"steps": [
				"run xschema generate on a test config using typescript adapter",
				"verify generated file has type definitions only, no runtime code",
				"verify the types are syntactically valid TypeScript"
			],
			"passes": false
		},
		{
			"id": "typescript-readme",
			"category": "cleanup",
			"description": "Create README.md that clearly explains this is a TYPE-ONLY adapter. No runtime validation. List what IS expressible (structure, unions, intersections, literals) vs what is NOT (constraints, negation, conditional validation).",
			"steps": [
				"verify README.md clearly states TYPE-ONLY in title/description",
				"verify it lists expressible vs non-expressible features",
				"verify usage example shows generated type output"
			],
			"passes": false
		},
		{
			"id": "typescript-compliance-docs",
			"category": "cleanup",
			"description": "Create compliance documentation that explains why the standard test suite doesn't apply. Type-only adapters cannot be validated against runtime test cases - document what the adapter does and doesn't support.",
			"steps": [
				"verify compliance/results/REPORT.md exists",
				"verify it explains TYPE-ONLY nature and why validation tests don't apply",
				"verify it lists supported JSON Schema features (structural) vs unsupported (runtime constraints)"
			],
			"passes": false,
			"notes": "Type-only adapters don't run the standard compliance test suite"
		},
		{
			"id": "typescript-docs",
			"category": "cleanup",
			"description": "Create remaining documentation: CHANGELOG.md.",
			"steps": [
				"verify CHANGELOG.md exists"
			],
			"passes": false
		},
		// ============================================
		// COMPLIANCE HARNESS ENHANCEMENT
		// ============================================
		{
			"id": "harness-typecheck",
			"category": "architectural",
			"description": "Add typecheck step to compliance harness for all adapters. After generating code, run tsc --noEmit on the generated files to catch type errors in the generated code. Capture typecheck errors in the compliance results.",
			"steps": [
				"run: xschema compliance on zod adapter",
				"verify output mentions typecheck step",
				"introduce a deliberate type error in zod adapter, run compliance",
				"verify typecheck failure is captured in results",
				"revert the deliberate error, verify zod adapter still passes"
			],
			"passes": false,
			"notes": "This is a Go CLI change in cli/compliance/"
		},
		{
			"id": "harness-typeonly-mode",
			"category": "architectural",
			"description": "Support type-only adapters in compliance harness. When an adapter returns empty schema (no runtime code), skip validation tests but still run typecheck on the generated types.",
			"steps": [
				"run: xschema compliance on typescript adapter",
				"verify validation is skipped (output indicates type-only mode)",
				"verify typecheck still runs on generated types",
				"verify REPORT.md is generated with appropriate type-only messaging"
			],
			"passes": false
		}
	]
}
