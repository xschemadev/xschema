{
  "description": "Python Pydantic adapter fixes: dedup helper functions, fix output dir naming, add type-safe client, remove redundant ref handling, improve compliance",
  "status": "in_progress",
  "last_reviewed": "2026-01-19",
  "items": [
    {
      "id": "cli-output-dir-config",
      "category": "architectural",
      "description": "Add OutputDir field to Language interface for customizable output folder names",
      "steps": [
        "edit cli/language/language.go and add OutputDir field to Language struct with default '.xschema'",
        "edit cli/cmd/generate.go to use lang.OutputDir instead of hardcoded '.xschema' when --output not specified",
        "edit cli/language/langs/typescript/typescript.go to set OutputDir: '.xschema' explicitly",
        "edit cli/language/langs/python/python.go to set OutputDir: '_xschema'",
        "run 'go build -o xschema .' from cli/ - must compile",
        "run 'go vet ./...' from cli/ - must pass",
        "run 'go test ./...' from cli/ - must pass"
      ],
      "passes": true,
      "notes": "Python can't import from folders starting with '.' - use '_xschema' instead"
    },
    {
      "id": "pydantic-dedup-helpers",
      "category": "refactor",
      "description": "Deduplicate helper functions in generated Python code (_json_equals, etc.)",
      "steps": [
        "edit python/packages/adapters/pydantic/src/xschema_pydantic/renderer.py",
        "add module-level helper registry (set of helper names needed)",
        "when generating uniqueItems/const validators, add helper name to registry instead of inlining",
        "emit all registered helpers once at start of render output",
        "validator functions reference helpers by name (_json_equals, _deep_equals)",
        "regenerate python/example: go run . generate --project ../python/example from cli/",
        "verify _json_equals appears exactly once in generated __init__.py",
        "run uv run pytest from python/ - all tests must pass"
      ],
      "passes": true,
      "notes": "Reduced from 80 definitions to 1 definition + 22 references. Helpers emitted once at module level."
    },
    {
      "id": "pydantic-dedup-imports",
      "category": "refactor",
      "description": "Fix import deduplication in generated Python code",
      "steps": [
        "review python/packages/adapters/pydantic/src/xschema_pydantic/import_collector.py",
        "ensure MergeImports in cli/language/langs/python/imports.go properly deduplicates",
        "verify imports like 'from typing import Annotated, Any, Literal' appear only once",
        "regenerate python/example and verify no duplicate import lines"
      ],
      "passes": true,
      "notes": "Fixed: removed hardcoded imports from template, added template-required imports to injector before merge"
    },
    {
      "id": "python-remove-ref-handling",
      "category": "cleanup",
      "description": "Remove redundant $ref resolution code from Python core - CLI handles bundling",
      "steps": [
        "read typescript/packages/core/src/parser/index.ts to confirm it throws on $ref",
        "edit python/packages/core/src/xschema_core/parser.py",
        "simplify _resolve_ref to throw error: CLI should pre-bundle all schemas",
        "remove _build_id_index function - not needed if CLI bundles",
        "remove _ParseContext fields: resolving, id_index, anchor_index",
        "keep minimal handling for internal $defs refs (#/$defs/Name) if bundler preserves them",
        "run 'uv run pytest' from python/ - tests must pass",
        "run compliance on pydantic adapter - must not regress"
      ],
      "passes": false,
      "notes": "Follow TS pattern: adapters receive fully bundled schemas from CLI"
    },
    {
      "id": "python-client-type-safety",
      "category": "functional",
      "description": "Add full type-safety to Python client with autocomplete for schema keys",
      "steps": [
        "edit python/packages/client/src/xschema_client/__init__.py",
        "add overload signatures for create_xschema_client with TypedDict schemas param",
        "use Literal types for known schema keys to enable autocomplete",
        "return type should be TypeAdapter[T] where T is the schema's model type",
        "edit cli/language/langs/python/templates.go to generate typed client wrapper",
        "generate XSchemaClient Protocol with __call__ overloads for each schema key",
        "verify mypy/pyright can autocomplete schema keys in example",
        "verify return type is correctly inferred (not Any/Unknown)"
      ],
      "passes": false,
      "notes": "Python lacks declaration merging - generate typed wrapper per-project"
    },
    {
      "id": "update-python-example",
      "category": "functional",
      "description": "Update Python example to use _xschema output dir and demonstrate type safety",
      "steps": [
        "delete python/example/.xschema/ folder",
        "run 'go run . generate' from cli/ targeting python/example",
        "verify python/example/_xschema/ is created (not .xschema)",
        "edit python/example/main.py to import from _xschema instead of .xschema",
        "remove sys.path manipulation hack - should work with normal import",
        "verify 'uv run python main.py' from python/example works",
        "add type: ignore comments only where truly needed, not as blanket"
      ],
      "passes": true,
      "notes": "Fixed Pydantic adapter to always create TypeAdapter for simple classes. Removed sys.path hack, example works with normal imports."
    },
    {
      "id": "pydantic-compliance-additionalprops",
      "category": "functional",
      "description": "Fix additionalProperties interaction with patternProperties",
      "steps": [
        "analyze failing tests: 'patternProperties are not additional properties'",
        "edit renderer.py to correctly validate additionalProperties excluding patternProperties matches",
        "run 'uv run --package xschema-pydantic xschema-pydantic' compliance tests",
        "verify additionalProperties tests pass"
      ],
      "passes": false,
      "notes": "6 failing additionalProperties tests per REPORT.md"
    },
    {
      "id": "pydantic-compliance-allof-anyof",
      "category": "functional",
      "description": "Fix allOf combined with anyOf/oneOf validation",
      "steps": [
        "analyze failing tests: 'allOf combined with anyOf, oneOf'",
        "edit renderer.py intersection handling to properly validate all branches",
        "run compliance tests",
        "verify allOf tests pass"
      ],
      "passes": false,
      "notes": "3 failing allOf tests per REPORT.md"
    },
    {
      "id": "pydantic-compliance-items-tuple",
      "category": "functional",
      "description": "Fix items with boolean schemas and legacy tuple validation",
      "steps": [
        "analyze failing tests: 'items with boolean schemas', 'an array of schemas for items'",
        "edit renderer.py tuple handling to allow empty arrays and partial tuples",
        "run compliance tests",
        "verify items tests pass"
      ],
      "passes": false,
      "notes": "5 failing items tests in draft2019-09 per REPORT.md"
    },
    {
      "id": "pydantic-compliance-refs",
      "category": "functional",
      "description": "Fix $ref interaction with sibling keywords",
      "steps": [
        "analyze failing tests: 'ref applies alongside sibling keywords', 'root pointer ref'",
        "verify CLI bundler handles these cases - may be bundler issue not adapter",
        "if adapter issue, fix in renderer.py",
        "run compliance tests",
        "verify ref tests pass"
      ],
      "passes": false,
      "notes": "8 failing ref tests - some may be CLI bundler issues"
    }
  ]
}
