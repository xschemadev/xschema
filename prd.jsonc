{
  "project": "xschema-adapters-perfect",
  "description": "Linear Pipeline Architecture & Full Compliance - Refactor CLI to use linear pipeline with Processor layer, pure bundler, and achieve 100% compliance",
  "userStories": [
    {
      "id": "US-001",
      "title": "Create Metaschema package",
      "description": "As a developer, I need a dedicated metaschema package for shared fetching, caching, and vocabulary extraction.",
      "acceptanceCriteria": [
        "Create `cli/metaschema/metaschema.go`",
        "`Get(uri string) (*Metaschema, error)` fetches and caches metaschemas",
        "`ExtractVocabulary(schema any) map[string]bool` extracts $vocabulary from metaschema",
        "`IsStandardDraft(uri string) bool` detects json-schema.org URLs",
        "`go build ./...` passes"
      ],
      "passes": false,
      "notes": ""
    },
    {
      "id": "US-002",
      "title": "Tests for Metaschema package",
      "description": "As a developer, I want comprehensive tests for the metaschema package covering edge cases.",
      "acceptanceCriteria": [
        "Create `cli/metaschema/metaschema_test.go`",
        "Test ExtractVocabulary with empty $vocabulary → returns map with all false",
        "Test ExtractVocabulary with missing $vocabulary → returns nil (all enabled)",
        "Test ExtractVocabulary with partial $vocabulary → only specified keys present",
        "Test IsStandardDraft: json-schema.org URLs return true",
        "Test IsStandardDraft: custom URLs return false",
        "Test Get() caching: second call returns cached result without network",
        "`go test ./cli/metaschema/...` passes"
      ],
      "passes": false,
      "notes": ""
    },
    {
      "id": "US-003",
      "title": "Add Fetcher interface to bundler",
      "description": "As a developer, I want the bundler to accept a Fetcher interface so it becomes pure (no direct I/O).",
      "acceptanceCriteria": [
        "Create `Fetcher` interface in bundler: `Fetch(uri string) (json.RawMessage, error)`",
        "Create `BundleInput` struct with Schema, SourceURI, Fetcher fields",
        "Change `Bundle()` signature to accept `BundleInput` instead of separate params",
        "Remove direct retriever/network calls from bundler",
        "`go build ./...` passes"
      ],
      "passes": false,
      "notes": ""
    },
    {
      "id": "US-004",
      "title": "Tests for bundler Fetcher interface",
      "description": "As a developer, I want tests verifying the bundler correctly uses the Fetcher interface.",
      "acceptanceCriteria": [
        "Test bundler calls Fetcher.Fetch() for external refs",
        "Test Fetcher error is propagated (bundler returns error)",
        "Test Fetcher returning invalid JSON causes bundler error",
        "Test nil Fetcher with external ref returns clear error",
        "Test local refs (#/...) don't call Fetcher",
        "`go test ./cli/bundler/...` passes"
      ],
      "passes": false,
      "notes": ""
    },
    {
      "id": "US-005",
      "title": "Fix bundler nested $defs flattening",
      "description": "As a schema author, I want refs to nested definitions in remote schemas to resolve correctly.",
      "acceptanceCriteria": [
        "Recursively extract nested `$defs` AND `definitions` (draft-04) to root level",
        "Nested defs get prefixed keys using `__` separator: `remote__foo__bar`",
        "Handle collision: if key exists, append counter: `remote__foo__2`",
        "Refs inside flattened defs rewritten to point to flattened locations",
        "Fragment refs to definitions work (e.g., `other.json#/$defs/Foo`)",
        "`go build ./...` passes"
      ],
      "passes": false,
      "notes": ""
    },
    {
      "id": "US-006",
      "title": "Tests for nested $defs flattening",
      "description": "As a developer, I want tests covering edge cases in nested definition flattening.",
      "acceptanceCriteria": [
        "Test 3-level nesting: $defs/A/$defs/B/$defs/C → flattened to root with __ separators",
        "Test mixed $defs and definitions (draft-04) in same schema both flatten",
        "Test key collision: two embedded schemas with same def name get unique keys",
        "Test refs inside flattened defs are rewritten to correct flattened locations",
        "Test deeply nested ref chain: A→B/$defs/X→C/$defs/Y resolves correctly",
        "`go test ./cli/bundler/...` passes"
      ],
      "passes": false,
      "notes": ""
    },
    {
      "id": "US-007",
      "title": "Create Processor package with crawlAndFetch",
      "description": "As a developer, I want a Processor layer that iteratively crawls and fetches external refs until no new URIs found.",
      "acceptanceCriteria": [
        "Create `cli/processor/processor.go`",
        "`Process(ctx, schemas, opts) ([]ProcessedSchema, error)` as main entry point",
        "ProcessedSchema contains: Namespace, ID, Schema (bundled), Adapter, SourceURI, Vocabulary",
        "Implement `crawlAndFetch()` - iteratively find $ref URIs and fetch until no new ones",
        "Track visited URIs to prevent infinite loops with circular refs",
        "Fail fast on any fetch error",
        "`go build ./...` passes"
      ],
      "passes": false,
      "notes": ""
    },
    {
      "id": "US-008",
      "title": "Tests for Processor crawlAndFetch",
      "description": "As a developer, I want comprehensive tests for the crawlAndFetch phase covering edge cases.",
      "acceptanceCriteria": [
        "Test no external refs → returns empty cache, no iterations",
        "Test single external ref → one fetch, cache contains it",
        "Test chained refs (A refs B, B refs C) → 2 iterations, cache has B and C",
        "Test circular refs (A refs B, B refs A) → terminates without infinite loop",
        "Test fragment-only refs (#/$defs/X) → no fetch triggered",
        "Test relative ref resolution respects $id base URI change",
        "Test fetch error → returns error immediately (fail fast), partial cache not exposed",
        "Test context cancellation → returns context error",
        "`go test ./cli/processor/...` passes"
      ],
      "passes": false,
      "notes": ""
    },
    {
      "id": "US-009",
      "title": "Add CacheFetcher for Processor",
      "description": "As a developer, I want the Processor to provide a CacheFetcher that looks up URIs in the pre-fetched cache.",
      "acceptanceCriteria": [
        "Create `CacheFetcher` type implementing Fetcher interface",
        "Returns schema from cache map, errors if URI not found (indicates crawler bug)",
        "Processor uses CacheFetcher when calling bundler in phase 3",
        "`go build ./...` passes"
      ],
      "passes": false,
      "notes": ""
    },
    {
      "id": "US-010",
      "title": "Tests for CacheFetcher",
      "description": "As a developer, I want tests for CacheFetcher covering hit and miss scenarios.",
      "acceptanceCriteria": [
        "Test cache hit: URI in cache → returns schema bytes",
        "Test cache miss: URI not in cache → returns error with descriptive message",
        "Test empty cache: any URI → returns error",
        "Test case sensitivity: URIs are matched exactly (http://A vs http://a)",
        "`go test ./cli/processor/...` passes"
      ],
      "passes": false,
      "notes": ""
    },
    {
      "id": "US-011",
      "title": "Add validation phase to Processor",
      "description": "As a developer, I want the Processor to validate all schemas (declared + external) just before bundling.",
      "acceptanceCriteria": [
        "Implement `validateAll()` phase in Processor",
        "Validates declared schemas AND all external schemas from cache",
        "Happens after crawlAndFetch, before bundleAll",
        "Uses existing validator package",
        "`go build ./...` passes"
      ],
      "passes": false,
      "notes": ""
    },
    {
      "id": "US-012",
      "title": "Add bundleAll phase to Processor",
      "description": "As a developer, I want the Processor to bundle all schemas using the CacheFetcher.",
      "acceptanceCriteria": [
        "Implement `bundleAll()` phase in Processor",
        "Bundles each declared schema using bundler with CacheFetcher",
        "No I/O during bundling - all refs resolve from cache",
        "Returns ProcessedSchema[] ready for Generator",
        "`go build ./...` passes"
      ],
      "passes": false,
      "notes": ""
    },
    {
      "id": "US-013",
      "title": "Tests for Processor full pipeline",
      "description": "As a developer, I want integration tests for the complete Processor pipeline.",
      "acceptanceCriteria": [
        "Test Process() with schema having no refs → returns bundled unchanged",
        "Test Process() with schema having external refs → returns bundled with refs embedded",
        "Test Process() with invalid schema → validation error returned",
        "Test Process() reports vocabulary from custom metaschema",
        "Test Process() with multiple schemas → all processed correctly",
