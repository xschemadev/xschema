{
  "description": "Python ecosystem setup: uv workspace, client package, CI/CD, PyPI publishing, and release automation. Goal is feature parity with TypeScript for DX.",
  "items": [
    {
      "id": "uv-workspace",
      "category": "architectural",
      "description": "Convert python/ to uv workspace with root pyproject.toml",
      "steps": [
        "create python/pyproject.toml with [tool.uv.workspace] members = ['packages/*', 'packages/adapters/*']",
        "verify workspace members: core, client (new), pydantic adapter",
        "run 'uv sync' from python/ root - should install all workspace members",
        "remove individual uv.lock files from packages (workspace uses single root lock)",
        "remove individual .venv dirs from packages",
        "verify 'uv run --package xschema-pydantic pytest' works from root"
      ],
      "passes": true,
      "notes": "Workspace provides single lockfile, shared deps, no relative path imports needed"
    },
    {
      "id": "python-client-package",
      "category": "functional",
      "description": "Create xschema-client package with type-safe schema lookup",
      "steps": [
        "create python/packages/client/ with pyproject.toml (name: xschema-client)",
        "implement create_xschema_client(schemas, default_namespace) returning callable",
        "client('namespace:id') returns validator from schemas dict",
        "client('id') with default_namespace prepends namespace",
        "raises XSchemaError if schema not found with helpful message",
        "full type inference via TypeVar and Generic - mypy should infer return types",
        "verify 'from xschema_client import create_xschema_client' works",
        "add py.typed marker for PEP 561",
        "add pytest tests for client: lookup, shorthand, error cases, type inference"
      ],
      "passes": true,
      "notes": "Mirror TS client API. Use generics for type safety since Python lacks declaration merging."
    },
    {
      "id": "python-example",
      "category": "functional",
      "description": "Create example project demonstrating Python xschema usage",
      "steps": [
        "create python/example/ with pyproject.toml",
        "add xschema config files using $schema: https://xschema.dev/schemas/python.jsonc",
        "add user.xschema.jsonc with Calendar schema (xschema-pydantic adapter)",
        "add subdir/another.xschema.jsonc with User schema (xschema-pydantic adapter)",
        "use similar JSON Schema sources as TS example (calendar.json, source.json)",
        "create main.py that imports generated schemas and uses client",
        "demonstrate: full key lookup ('user:Calendar'), shorthand with default_namespace ('User')",
        "demonstrate: Pydantic validation with model_validate()",
        "add 'generate' script that runs xschema generate --project .",
        "verify example works end-to-end: generate then run main.py"
      ],
      "passes": true,
      "notes": "Example uses only Pydantic adapter (Python only has this adapter currently)"
    },
    {
      "id": "python-ci-setup",
      "category": "integration",
      "description": "Create python/.ci/ for compliance workflow integration",
      "steps": [
        "create python/.ci/runtime.txt containing 'python'",
        "create python/.ci/setup.sh that runs 'uv sync'",
        "verify compliance.yml detects python runtime correctly",
        "run compliance workflow locally: go run . compliance --lang python --adapter-path ../python/packages/adapters/pydantic",
        "verify no errors in setup phase"
      ],
      "passes": true,
      "notes": "compliance.yml already supports python runtime detection, just need the files"
    },
    {
      "id": "pypi-cli-packages",
      "category": "architectural",
      "description": "Create platform-specific CLI packages for PyPI distribution",
      "steps": [
        "create python/cli/ directory structure mirroring cli/npm/",
        "create python/cli/xschema-cli/pyproject.toml with console_scripts entry point",
        "create python/cli/xschema-cli/src/xschema_cli/__init__.py with platform detection + exec",
        "create 6 platform packages: xschema-cli-{darwin,linux,win32}-{arm64,x64}/",
        "each platform package has pyproject.toml with classifier for os/arch",
        "main package declares platform packages as optional dependencies",
        "verify 'uv pip install xschema-cli' installs correct platform binary",
        "verify 'xschema --help' executes the Go binary"
      ],
      "passes": false,
      "notes": "Match npm pattern. Platform packages contain Go binary, main package does detection."
    },
    {
      "id": "ci-workflow-python",
      "category": "integration",
      "description": "Update CI workflow to build and typecheck Python packages",
      "steps": [
        "add paths filter for python/ in .github/workflows/ci.yml",
        "add py-build job: uv sync, uv run mypy, uv run pytest (if tests exist)",
        "add py-result passthrough job for branch protection",
        "verify CI runs on python/ changes only",
        "verify CI passes with current python code"
      ],
      "passes": true,
      "notes": "Follow same pattern as go-test and ts-build jobs"
    },
    {
      "id": "release-please-python",
      "category": "integration",
      "description": "Add Python packages to release-please configuration",
      "steps": [
        "add python/packages/core to release-please-config.json with release-type: python, component: py-core",
        "add python/packages/client to config with release-type: python, component: py-client",
        "add python/packages/adapters/pydantic to config with release-type: python, component: py-pydantic",
        "add initial versions to .release-please-manifest.json (all 0.1.0)",
        "verify release-please can parse the config: validate JSON syntax",
        "tags will be: py-core-v0.1.0, py-client-v0.1.0, py-pydantic-v0.1.0"
      ],
      "passes": true,
      "notes": "Component names prefixed with py- to avoid collision with TS (core, client, zod). python release-type updates pyproject.toml version and CHANGELOG.md automatically."
    },
    {
      "id": "release-workflow-pypi",
      "category": "integration",
      "description": "Add PyPI publishing to release workflow",
      "steps": [
        "add release-py job to .github/workflows/release-please.yml",
        "job triggers on py-* tags (py-core, py-client, py-pydantic)",
        "uses uv to build: uv build",
        "publishes to PyPI using uv publish with PYPI_TOKEN secret",
        "add comment documenting PYPI_TOKEN secret requirement",
        "verify workflow syntax is valid"
      ],
      "passes": false,
      "notes": "PYPI_TOKEN secret must be configured in GitHub repo settings"
    },
    {
      "id": "release-workflow-pypi-cli",
      "category": "integration",
      "description": "Add PyPI CLI binary publishing to release workflow",
      "steps": [
        "extend release-cli job to also publish Python CLI packages",
        "after Go binaries built, copy to python/cli/xschema-cli-{platform}/",
        "build and publish each platform package to PyPI",
        "build and publish main xschema-cli package",
        "verify all 7 packages (1 main + 6 platform) publish correctly"
      ],
      "passes": false,
      "notes": "CLI publishes on cli-* tags, same as npm. Requires PYPI_TOKEN."
    },
    {
      "id": "update-injector-template",
      "category": "functional",
      "description": "Update Python output template to work with new client",
      "steps": [
        "review cli/language/langs/python/templates.go outputTemplate",
        "ensure generated code exports schemas dict compatible with client",
        "ensure SchemaTypes TypedDict is correct for type inference",
        "verify register_schemas() function works with client._register_schemas()",
        "regenerate example output and verify it works with client"
      ],
      "passes": true,
      "notes": "Template already has most of what's needed, may need minor adjustments"
    }
  ]
}
