{
  // Support adapters that generate only schemas OR only types (not necessarily both)
  // Currently all adapters return both, but the system should handle:
  // - Schema + Type (current: zod, arktype)
  // - Type only (future: pure TS type generator)
  // - Schema only (future: validator without type inference)
  //
  // Key behaviors:
  // - `schemas` object: only entries with runtime values (.Code)
  // - `SchemaTypes`: all entries (uses `typeof varName` for schema-only)
  // - Client `lookup()`: compile-time restricted to schema keys
  // - `XSchemaType<K>`: works for ALL keys in SchemaTypes
  "description": "Enable adapters to output schema-only or type-only, with proper CLI validation, template handling, and client type safety",

  "items": [
    {
      "id": "core-types-optional",
      "category": "architectural",
      "description": "Make schema and type fields optional in ConvertResult",
      "steps": [
        "ConvertResult.schema is an optional field",
        "ConvertResult.type is an optional field",
        "run bun run typecheck in typescript/ - passes"
      ],
      "passes": true
    },
    {
      "id": "cli-validation",
      "category": "functional",
      "description": "Add CLI validation that adapter returns at least one of schema or type",
      "steps": [
        "CLI errors when adapter returns neither schema nor type",
        "error message includes namespace:id to identify the problematic entry",
        "CLI accepts outputs with only schema (no type)",
        "CLI accepts outputs with only type (no schema)",
        "run go build, go vet, go test in cli/ - all pass"
      ],
      "passes": false
    },
    {
      "id": "template-schemas-conditional",
      "category": "functional",
      "description": "Fix TS template to only add entries to schemas object if .Code exists",
      "steps": [
        "type-only entries are NOT in the schemas object",
        "schema-only entries ARE in the schemas object",
        "schema+type entries ARE in the schemas object",
        "SchemaTypes includes all entries regardless of schema/type presence",
        "run go build, go test in cli/ - passes"
      ],
      "passes": false,
      "notes": "The SchemaTypes section already has conditional logic for all 3 cases. Only the schemas object needs fixing."
    },
    {
      "id": "client-types-separation",
      "category": "functional",
      "description": "Update client types so XSchemaType accepts all keys, lookup only schema keys",
      "steps": [
        "XSchemaType<K> accepts keys from schemaTypes (including type-only entries)",
        "lookup() only accepts keys that exist in schemas object",
        "attempting to lookup a type-only key causes a compile error",
        "run bun run build and bun run typecheck in typescript/ - passes"
      ],
      "passes": false,
      "notes": "Goal: type-only entries can be used with XSchemaType but not with runtime lookup"
    },
    {
      "id": "unit-tests",
      "category": "test",
      "description": "Add/update Go tests for schema-only and type-only behavior",
      "steps": [
        "injector test for type-only: entry is NOT in schemas object",
        "injector test for type-only: entry IS in SchemaTypes",
        "injector test for schema-only: entry IS in schemas object",
        "injector test for schema-only: entry IS in SchemaTypes (via typeof)",
        "generator test for 'neither schema nor type' returns error",
        "run go test ./... in cli/ - passes"
      ],
      "passes": false,
      "notes": "Existing tests (TestInject_TypeOnly, TestInject_SchemaOnly) need updating to verify schemas object membership, not just export statements."
    },
    {
      "id": "client-readme",
      "category": "cleanup",
      "description": "Create client README documenting schema vs type distinction",
      "steps": [
        "README.md exists at typescript/packages/client/",
        "documents createXSchemaClient usage with code examples",
        "documents XSchemaType helper with code examples",
        "explains that type-only adapters cannot be looked up at runtime",
        "covers schema-only vs type-only vs both scenarios"
      ],
      "passes": false
    },
    {
      "id": "integration-verification",
      "category": "test",
      "description": "Verify the full generation flow works with existing example",
      "steps": [
        "run xschema generate in typescript/example/ - completes without errors",
        "generated xschema.gen.ts is valid TypeScript (passes typecheck)",
        "schemas object in generated file contains runtime validators",
        "SchemaTypes in generated file contains type definitions"
      ],
      "passes": false,
      "notes": "Tests existing adapters (zod, arktype) which return both. Type-only adapter testing is out of scope."
    }
  ]
}
