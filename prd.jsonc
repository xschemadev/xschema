  "items": [
    // ============================================
    // PHASE 1: Critical Code Generation Bugs
    // ============================================
    {
      "id": "fix-none-union-syntax",
      "category": "functional",
      "description": "Fix 'None | None' type annotation error in allOf merging",
      "steps": [
        "Run: cd python/packages/adapters/pydantic && echo '[{\"namespace\":\"t\",\"id\":\"T\",\"varName\":\"t\",\"schema\":{\"allOf\":[{\"type\":\"null\"},{\"type\":\"null\"}]}}]' | uv run python -m xschema_pydantic",
        "Verify output doesn't produce 'None | None' type annotation",
        "Check render_intersection in renderer.py handles duplicate null types",
        "Test allOf with two identical schemas doesn't produce duplicate union types",
        "Run: cd python/packages/adapters/pydantic && ../../../../cli/xschema compliance --lang python --draft draft2020-12 --keyword allOf",
        "Verify allOf tests don't crash with TypeError about NoneType",
      ],
      "passes": true,
      "notes": "Currently allOf crashes entire test batch with: TypeError: unsupported operand type(s) for |: 'NoneType' and 'NoneType'",
    },
    {
      "id": "fix-non-object-validation",
      "category": "functional",
      "description": "JSON Schema object keywords must ignore non-object inputs",
      "steps": [
        "Understand: {properties: {foo: {type: integer}}} should validate 12, [], 'hello' as VALID (they're not objects)",
        "Modify render_object to generate TypeAdapter that checks isinstance(v, dict) first",
        "Non-dicts should pass validation (return True), only dicts get property validation",
        "Run: cd python/packages/adapters/pydantic && ../../../../cli/xschema compliance --lang python --draft draft2020-12 --keyword properties",
        "Verify 'ignores arrays' and 'ignores other non-objects' tests pass",
        "Same fix needed for additionalProperties, patternProperties, propertyNames",
        "Run properties, additionalProperties compliance tests and verify improvement",
      ],
      "passes": true,
      "notes": "Fixed in converter.py. Non-dicts now pass validation for object schemas. Properties keyword shows 0% due to pre-existing bug with escaped chars in property names (Group3 tests). additionalProperties=71.4%, propertyNames=75%, patternProperties=56.5%, required=68.8% - all improved.",
    },
    {
      "id": "fix-const-enum-validation",
      "category": "functional",
      "description": "Fix const and enum validation to work with any JSON value",
      "steps": [
        "Run: cd python/packages/adapters/pydantic && ../../../../cli/xschema compliance --lang python --draft draft2020-12 --keyword const --verbose",
        "Run: cd python/packages/adapters/pydantic && ../../../../cli/xschema compliance --lang python --draft draft2020-12 --keyword enum --verbose",
        "Identify why 0/54 const tests and 0/45 enum tests pass",
        "Verify Literal types work for string, number, boolean, null values",
        "Verify arrays and objects in const/enum use custom validators (Literal only works for primitives)",
        "Test const: {const: [1,2,3]} validates [1,2,3] as valid",
        "Test enum: {enum: [{\"a\":1}, null]} validates correctly",
      ],
      "passes": true,
      "notes": "Fixed. const=100%, enum=100%. Key fixes: (1) escape null bytes in string literals with json.dumps, (2) use _make_const_validator for complex values, (3) implement _deep_equals to prevent Python's bool/int coercion (False==0, True==1).",
    },
    // ============================================
    // PHASE 2: Semantic Compliance Fixes
    // ============================================
    {
      "id": "fix-multipleOf",
      "category": "functional",
      "description": "Fix multipleOf validation for integers and floats",
      "steps": [
        "Run: cd python/packages/adapters/pydantic && ../../../../cli/xschema compliance --lang python --draft draft2020-12 --keyword multipleOf --verbose",
        "Identify why 0/10 multipleOf tests pass",
        "Verify annotated_types.MultipleOf is being used correctly",
        "Handle floating point precision issues (0.3 / 0.1 might not equal 3.0 exactly)",
        "Test multipleOf: 2 with value 4 passes",
        "Test multipleOf: 0.01 with value 1.1 passes",
      ],
      "passes": true,
      "notes": "Fixed. 100% (10/10). Key fixes: (1) Added type guards for number-only schemas without explicit type (ignores non-numbers), (2) Handle integer type with float multipleOf using custom BeforeValidator since Pydantic's MultipleOf doesn't support non-integer values for int types.",
    },
    {
      "id": "fix-format-validation",
      "category": "functional",
      "description": "Fix format string validation (0/114 tests passing)",
      "steps": [
        "Run: cd python/packages/adapters/pydantic && ../../../../cli/xschema compliance --lang python --draft draft2020-12 --keyword format --verbose",
        "Identify which formats are failing and why",
        "Verify email format uses EmailStr correctly",
        "Verify date/datetime formats use correct Python types",
        "Verify uri format validates correctly",
        "Check if formats need to be explicitly enabled in Pydantic config",
        "Handle unknown formats gracefully (should not fail, just skip validation)",
      ],
      "passes": false,
      "notes": "Format validation is opt-in in JSON Schema. Check if we need to adjust approach.",
    },
    {
      "id": "fix-ref-validation",
      "category": "functional",
      "description": "Fix $ref resolution in bundled schemas",
      "steps": [
        "Run: cd python/packages/adapters/pydantic && ../../../../cli/xschema compliance --lang python --draft draft2020-12 --keyword ref --verbose",
        "Identify why 0/0 ref tests pass (0 tests is suspicious - are they filtered?)",
        "Verify RefNode with resolved field renders the resolved schema correctly",
        "Verify forward references to $defs work via Python string annotations",
        "Test schema with $ref to $defs validates correctly",
      ],
      "passes": false,
      "notes": "CLI bundles refs, so resolved should always be populated. Forward refs need quotes.",
    },
    {
      "id": "fix-type-keyword",
      "category": "functional",
      "description": "Fix remaining 7 type keyword failures (91.2% passing)",
      "steps": [
        "Run: cd python/packages/adapters/pydantic && ../../../../cli/xschema compliance --lang python --draft draft2020-12 --keyword type --verbose 2>&1 | grep -A5 'FAIL\\|Error'",
        "Identify the 7 failing tests",
        "Common issue: type: [\"string\", \"null\"] should accept null values",
        "Verify type arrays create correct unions",
        "Test type: ['integer', 'null'] accepts both 5 and null",
      ],
      "passes": true,
      "notes": "Fixed. 100% (80/80). Key fixes: (1) Use StrictBool for boolean type (integers 0/1 are not booleans), (2) Use StrictInt for integer type, (3) Use StrictFloat for number type, (4) Use StringConstraints(strict=True) for string constraints, (5) Fix _is_object_only_schema to check for explicit type keyword - schemas with type:object should reject non-objects.",
    },
    {
      "id": "fix-oneOf-validation",
      "category": "functional",
      "description": "Fix remaining 2 oneOf failures (92.6% passing)",
      "steps": [
        "Run: cd python/packages/adapters/pydantic && ../../../../cli/xschema compliance --lang python --draft draft2020-12 --keyword oneOf --verbose 2>&1 | grep -A5 'FAIL\\|Error'",
        "Identify the 2 failing tests",
        "Verify exactly-one matching logic is correct",
        "Fix edge cases where validation errors vs matches are counted incorrectly",
      ],
      "passes": false,
      "notes": "Currently at 92.6%, close to 100%",
    },
    // ============================================
    // PHASE 3: Array/Tuple Fixes
    // ============================================
    {
      "id": "fix-items-validation",
      "category": "functional",
      "description": "Fix items keyword validation (0/0 tests - likely filtered)",
      "steps": [
        "Run: cd python/packages/adapters/pydantic && ../../../../cli/xschema compliance --lang python --draft draft2020-12 --keyword items --verbose",
        "Verify items schema applies to all array elements",
        "Verify items: false means no additional items allowed after prefixItems",
        "Test items with nested schema validates each element",
      ],
      "passes": false,
      "notes": "0/0 suggests tests are filtered - may need to check why",
    },
    {
      "id": "fix-additionalItems",
      "category": "functional",
      "description": "Fix additionalItems validation (13/19 passing)",
      "steps": [
        "Run compliance for additionalItems and identify 6 failures",
        "Fix: 'additionalItems are allowed by default' - empty prefix should allow any items",
        "Fix: 'does not look in applicators' - additionalItems shouldn't check allOf subschemas",
        "Fix: 'no additionalItems permitted' edge cases with empty array",
        "Verify generated code handles both legacy (items array) and modern (prefixItems) syntax",
      ],
      "passes": false,
      "notes": "Need to handle interaction between items-as-array and additionalItems",
    },
    {
      "id": "fix-uniqueItems",
      "category": "functional",
      "description": "Fix uniqueItems validation (52/69 passing)",
      "steps": [
        "Run compliance for uniqueItems and identify 17 failures",
        "Fix deep equality comparison for objects and arrays",
        "Handle edge case: NaN != NaN in JSON but should be equal for uniqueness",
        "Handle edge case: 1 and 1.0 should be considered equal",
        "Test unique detection for nested objects",
      ],
      "passes": false,
      "notes": "Python set() won't work for unhashable types. Need custom comparison.",
    },
    // ============================================
    // PHASE 4: Object Keyword Fixes
    // ============================================
    {
      "id": "fix-required-validation",
      "category": "functional",
      "description": "Fix required keyword validation (6/16 passing)",
      "steps": [
        "Run compliance for required and identify 10 failures",
        "Understand: required only applies if input is an object",
        "Non-objects should pass validation",
        "Required fields that exist with any value (including null) satisfy required",
        "Test required with property set to null should pass",
      ],
      "passes": false,
      "notes": "Required checks presence, not truthiness",
    },
    {
      "id": "fix-dependentRequired",
      "category": "functional",
      "description": "Fix dependentRequired validation (14/20 passing)",
      "steps": [
        "Run compliance for dependentRequired and identify 6 failures",
        "Verify conditional property requirements work correctly",
        "Should ignore non-objects",
        "Test: if foo exists, bar must exist",
      ],
      "passes": false,
    },
    {
      "id": "fix-dependentSchemas",
      "category": "functional",
      "description": "Fix dependentSchemas validation (10/20 passing)",
      "steps": [
        "Run compliance for dependentSchemas and identify 10 failures",
        "Verify schema dependencies are validated when trigger property exists",
        "Should ignore non-objects",
        "Test: if foo exists, validate against {type: object, properties: {bar: {type: number}}}",
      ],
      "passes": false,
    },
    {
      "id": "fix-patternProperties",
      "category": "functional",
      "description": "Fix patternProperties validation (10/23 passing)",
      "steps": [
        "Run compliance for patternProperties and identify 13 failures",
        "Verify regex patterns match property names correctly",
        "Should ignore non-objects",
        "Handle interaction with properties and additionalProperties",
        "Test non-ASCII patterns",
      ],
      "passes": false,
    },
    {
      "id": "fix-propertyNames",
      "category": "functional",
      "description": "Fix propertyNames validation (15/20 passing)",
      "steps": [
        "Run compliance for propertyNames and identify 5 failures",
        "Verify all property names are validated against schema",
        "Should ignore non-objects",
        "Test propertyNames with pattern constraint",
      ],
      "passes": false,
    },
    // ============================================
    // PHASE 5: Constraint Fixes
    // ============================================
    {
      "id": "fix-min-max-constraints",
      "category": "functional",
      "description": "Fix remaining min/max constraint edge cases",
      "steps": [
        "Run compliance for minLength, maxLength (6/7 each)",
        "Run compliance for minItems, maxItems (5/6 each)",
        "Run compliance for minProperties, maxProperties",
        "Run compliance for minimum, maximum, exclusiveMinimum, exclusiveMaximum",
        "Identify and fix the edge case failures",
        "Common issue: constraints should ignore non-applicable types",
      ],
      "passes": false,
      "notes": "Most are at 80%+, need to find edge cases",
    },
    {
      "id": "fix-pattern-validation",
      "category": "functional",
      "description": "Fix pattern validation (3/9 passing)",
      "steps": [
        "Run compliance for pattern and identify 6 failures",
        "Verify regex compilation and matching",
        "Handle ECMA vs Python regex differences",
        "Test non-ASCII patterns",
        "Verify pattern should ignore non-strings",
      ],
      "passes": false,
    },
    {
      "id": "fix-contains-minContains-maxContains",
      "category": "functional",
      "description": "Fix contains constraint validation",
      "steps": [
        "Run compliance for contains (14/21), minContains (14/28), maxContains (6/12)",
        "Verify at least minContains items match contains schema",
        "Verify at most maxContains items match",
        "Handle edge case: minContains: 0 means contains is optional",
        "Test contains with maxContains: 1 allows only one match",
      ],
      "passes": false,
    },
    // ============================================
    // PHASE 6: Not and Composition Edge Cases
    // ============================================
    {
      "id": "fix-not-validation",
      "category": "functional",
      "description": "Fix remaining not validation edge case (37/38 passing)",
      "steps": [
        "Run compliance for not and identify 1 failure",
        "Verify negation logic is correct",
        "Check if the failure is related to unsupported unevaluatedProperties",
      ],
      "passes": false,
      "notes": "Very close to 100%",
    },
    // ============================================
    // PHASE 7: Final Verification
    // ============================================
    {
      "id": "compliance-full-run",
      "category": "integration",
      "description": "Run full compliance suite and verify target reached",
      "steps": [
        "Run: cd python/packages/adapters/pydantic && ../../../../cli/xschema compliance --lang python --draft draft2020-12",
        "Verify all fixable tests pass (target: ~650+ passed out of ~920)",
        "Verify unsupported features are correctly documented (~200 tests)",
        "Verify 0 unexpected failures",
        "Calculate final compliance percentage for passable tests: passed/(passed+failed) >= 95%",
        "Run --dev-report and commit updated REPORT.md",
      ],
      "passes": false,
      "notes": "Goal: 100% compliance for features we claim to support",
    },
    {
      "id": "verify-all-drafts",
      "category": "integration",
      "description": "Verify compliance improvements across all draft versions",
      "steps": [
        "Run compliance for draft2020-12, draft2019-09, draft7, draft6, draft4",
        "Verify improvements are consistent across drafts",
        "Document any draft-specific limitations",
        "Commit final REPORT.md with all draft results",
      ],
      "passes": false,
    },
    {
      "id": "verify-tests-pass",
      "category": "test",
      "description": "Ensure existing unit tests still pass after fixes",
      "steps": [
        "Run: cd python/packages/core && uv run pytest tests/ -v",
        "Run: cd python/packages/adapters/pydantic && uv run pytest tests/ -v",
        "Verify 85+ tests pass",
        "Add new tests for any complex fixes made",
      ],
      "passes": false,
    },
  ],
}
