{
  "description": "Build xschema-pydantic adapter: JSON Schema -> Pydantic v2 code generator. Aligns Python IR with TypeScript core, restructures for maintainability, targets 100% compliance.",
  "items": [
    // ============================================
    // PHASE 1: Align with CLI Redesign
    // ============================================
    {
      "id": "align-ir-with-ts",
      "category": "architectural",
      "description": "Update Python IR to match TypeScript core IR exactly",
      "steps": [
        "Add OneOfNode (separate from UnionNode) with schemas tuple",
        "Add NotNode with inner schema field",
        "Add ConditionalNode with if/then/else fields",
        "Add TypeGuardedNode with guards list (TypeGuard has check: str and schema)",
        "Add NullableNode with inner field (for OpenAPI 3.0 nullable)",
        "Update StringNode: move constraints into StringConstraints dataclass (minLength, maxLength, pattern), keep format separate",
        "Update NumberNode: move constraints into NumberConstraints dataclass",
        "Update ArrayNode: add constraints field (ArrayConstraints with minItems, maxItems, uniqueItems, contains), add unevaluatedItems field",
        "Update TupleNode: add constraints field (ArrayConstraints), add unevaluatedItems field, change restItems to allow False",
        "Update ObjectNode: add patternProperties, propertyNames, minProperties, maxProperties, dependencies, unevaluatedProperties fields",
        "Add ContainsConstraint dataclass (schema, minContains, maxContains)",
        "Add PatternPropertyDef dataclass (pattern, schema)",
        "Add Dependency type (PropertyDependency | SchemaDependency)",
        "Export all types from __init__.py",
        "Run 'uv run pytest tests/' in core package and verify existing tests still pass"
      ],
      "passes": true,
      "notes": "IR must be 1:1 with TS version. Existing tests may need updates for new constraint structure."
    },
    {
      "id": "align-parser-with-ts",
      "category": "functional",
      "description": "Update Python parser to handle all IR node types like TS parser",
      "steps": [
        "Update parse() to handle oneOf -> OneOfNode (not UnionNode)",
        "Add parsing for not keyword -> NotNode",
        "Add parsing for if/then/else -> ConditionalNode",
        "Add parsing for typeless schemas with type-specific keywords -> TypeGuardedNode",
        "Add parsing for nullable: true (OpenAPI 3.0) -> NullableNode",
        "Update string parsing to use StringConstraints",
        "Update number parsing to use NumberConstraints",
        "Update array parsing to use ArrayConstraints and handle contains/unevaluatedItems",
        "Update tuple parsing to use ArrayConstraints and handle unevaluatedItems",
        "Update object parsing: handle patternProperties, propertyNames, min/maxProperties, dependencies, unevaluatedProperties",
        "Simplify $ref handling - CLI bundles everything, throw error if $ref encountered",
        "Run 'uv run pytest tests/' and fix any failing tests",
        "Add new tests for new node types (NotNode, ConditionalNode, TypeGuardedNode, NullableNode)"
      ],
      "passes": true,
      "notes": "Parser should be simpler than TS version since CLI does normalization. Throw on $ref since schemas should be pre-bundled."
    },
    {
      "id": "verify-existing-renderer",
      "category": "test",
      "description": "Verify existing renderer works with updated IR structure",
      "steps": [
        "Update render() to use new constraint structure (node.constraints.min_length instead of node.min_length)",
        "Update render_string() for StringConstraints",
        "Update render_number() for NumberConstraints",
        "Update render_array() for ArrayConstraints",
        "Update render_object() for new fields (ignore advanced features for now, just don't break)",
        "Test CLI still works: echo '[{\"namespace\":\"test\",\"id\":\"X\",\"varName\":\"test_x\",\"schema\":{\"type\":\"string\"}}]' | uv run xschema-pydantic",
        "Verify output is valid JSON with schema/type/imports fields"
      ],
      "passes": true,
      "notes": "Quick verification that refactored IR doesn't break existing functionality."
    },
    // ============================================
    // PHASE 2: Complete Renderer Implementation  
    // ============================================
    {
      "id": "renderer-arrays-tuples",
      "category": "functional",
      "description": "Complete renderer for array and tuple types",
      "steps": [
        "Render ArrayNode -> list[ItemType]",
        "Handle array constraints via Annotated[list[T], Field(min_length=, max_length=)]",
        "Handle uniqueItems with custom validator (Pydantic doesn't have built-in)",
        "Handle contains constraint with custom validator",
        "Handle unevaluatedItems (simple case: treat like items since CLI filters complex cases)",
        "Render TupleNode -> tuple[A, B, C]",
        "Handle tuple with rest items: tuple[A, B, ...] pattern or custom validator",
        "Handle tuple unevaluatedItems",
        "For root-level arrays/tuples, wrap in TypeAdapter",
        "Test array with minItems/maxItems validates correctly",
        "Test tuple with 3 elements validates correctly",
        "Test generated code executes without errors"
      ],
      "passes": true
    },
    {
      "id": "renderer-unions-intersections",
      "category": "functional",
      "description": "Complete renderer for union and intersection types",
      "steps": [
        "Render UnionNode -> A | B | C (Python union syntax)",
        "Handle discriminated unions with Annotated[..., Field(discriminator='field')]",
        "Render OneOfNode -> custom validator ensuring exactly one schema matches",
        "Render IntersectionNode -> merge object properties or multiple inheritance",
        "Handle intersection of objects: create merged class with all properties",
        "Handle intersection with primitives: use most restrictive type",
        "Render NotNode -> custom validator checking schema doesn't match",
        "Render NullableNode -> T | None",
        "Test simple union validates correctly",
        "Test discriminated union validates correctly",
        "Test oneOf rejects when multiple schemas match"
      ],
      "passes": true,
      "notes": "Discriminated unions in Pydantic require all variants to have Literal type for discriminator field."
    },
    {
      "id": "renderer-conditionals",
      "category": "functional",
      "description": "Implement renderer for conditional and type-guarded schemas",
      "steps": [
        "Render ConditionalNode -> custom validator with if/then/else logic",
        "If 'if' matches and 'then' exists, validate against 'then'",
        "If 'if' doesn't match and 'else' exists, validate against 'else'",
        "Render TypeGuardedNode -> custom validator applying schema based on runtime type",
        "For object guard: check isinstance(val, dict)",
        "For array guard: check isinstance(val, list)",
        "For string guard: check isinstance(val, str)",
        "For number guard: check isinstance(val, (int, float))",
        "Test if/then/else validates correctly",
        "Test type-guarded schema applies constraints only to matching types"
      ],
      "passes": true
    },
    {
      "id": "renderer-formats",
      "category": "functional",
      "description": "Implement format string type mappings",
      "steps": [
        "Map format='email' -> pydantic.EmailStr",
        "Map format='uri' -> pydantic.AnyUrl or HttpUrl",
        "Map format='uuid' -> uuid.UUID",
        "Map format='date' -> datetime.date",
        "Map format='date-time' -> datetime.datetime",
        "Map format='time' -> datetime.time",
        "Map format='ipv4' -> pydantic.IPvAnyAddress with custom validator",
        "Map format='ipv6' -> pydantic.IPvAnyAddress with custom validator",
        "Map format='hostname' -> str with regex pattern validator",
        "Unknown formats -> str (no validation, as per JSON Schema spec)",
        "Add imports for each format type used",
        "Test email format rejects invalid emails",
        "Test uuid format accepts valid UUIDs"
      ],
      "passes": true,
      "notes": "Some formats use Pydantic types, others need Annotated with validators."
    },
    {
      "id": "renderer-object-advanced",
      "category": "functional",
      "description": "Complete object renderer with all JSON Schema features",
      "steps": [
        "Handle patternProperties with custom validator matching regex patterns",
        "Handle propertyNames with custom validator checking key schemas",
        "Handle minProperties/maxProperties with len() validator",
        "Handle dependencies (property and schema dependencies)",
        "Handle unevaluatedProperties (simple case: treat like additionalProperties)",
        "For additionalProperties as schema: add custom validator for extra props",
        "Test object with patternProperties validates matching keys",
        "Test object with minProperties rejects too few properties",
        "Test dependencies trigger correctly"
      ],
      "passes": true,
      "notes": "Complex features need superRefine-style validators. Pydantic's model_validator(mode='after') is the equivalent."
    },
    // ============================================
    // PHASE 3: Code Quality & Testing
    // ============================================
    {
      "id": "import-collection",
      "category": "functional",
      "description": "Implement proper import tracking and deduplication",
      "steps": [
        "Create ImportCollector class to track imports during rendering",
        "Support grouping: typing, datetime, uuid, pydantic, annotated_types",
        "Format as 'from module import Name1, Name2' style",
        "Deduplicate imports automatically",
        "Handle conditional imports (only add if feature used)",
        "Return imports list in ConvertResult sorted by module",
        "Test no duplicate imports in output",
        "Test correct imports for complex schema using multiple features"
      ],
      "passes": true
    },
    {
      "id": "renderer-unit-tests",
      "category": "test",
      "description": "Comprehensive unit tests for Pydantic renderer",
      "steps": [
        "Create tests/test_renderer.py in pydantic adapter",
        "Test rendering string with constraints",
        "Test rendering number with constraints",
        "Test rendering object with properties",
        "Test rendering nested objects",
        "Test rendering arrays with constraints",
        "Test rendering tuples",
        "Test rendering unions (simple and discriminated)",
        "Test rendering oneOf with exactly-one validation",
        "Test rendering intersections",
        "Test rendering enums and literals",
        "Test rendering format strings",
        "Test rendering conditionals (if/then/else)",
        "Test rendering type-guarded schemas",
        "Test TypeAdapter generation for non-objects",
        "Run 'uv run pytest tests/' and verify all pass"
      ],
      "passes": true
    },
    {
      "id": "integration-test",
      "category": "integration",
      "description": "End-to-end integration test with CLI",
      "steps": [
        "Create test fixture with various schema types",
        "Run xschema-pydantic via stdin/stdout",
        "Verify output JSON structure is valid",
        "Verify each result has namespace, id, varName, imports, schema, type",
        "Write generated code to temp file",
        "Import generated module and verify no syntax errors",
        "Validate test data against generated schemas",
        "Verify valid data passes, invalid data fails"
      ],
      "passes": false
    },
    {
      "id": "compliance-baseline",
      "category": "integration",
      "description": "Run compliance tests and establish baseline",
      "steps": [
        "Navigate to cli/ directory",
        "Run: go run . compliance --adapter-path ../python/packages/adapters/pydantic --lang python",
        "Capture initial pass/fail/unsupported counts",
        "Review failures to identify categories",
        "Document known limitations in REPORT.md",
        "Target: establish baseline metrics for iterative improvement"
      ],
      "passes": false,
      "notes": "Initial run to understand where we stand. 100% is the goal but incremental progress is expected."
    },
    // ============================================
    // PHASE 4: Compliance Improvements
    // ============================================
    {
      "id": "compliance-primitives",
      "category": "integration",
      "description": "Fix compliance failures for primitive types",
      "steps": [
        "Run compliance, filter to string/number/boolean/null failures",
        "Fix string minLength/maxLength edge cases (grapheme clusters vs bytes)",
        "Fix number multipleOf floating point precision issues",
        "Fix integer type coercion (JSON number vs Python int)",
        "Re-run compliance and verify primitive failures reduced",
        "Document any remaining known limitations"
      ],
      "passes": false
    },
    {
      "id": "compliance-objects",
      "category": "integration",
      "description": "Fix compliance failures for object types",
      "steps": [
        "Run compliance, filter to object-related failures",
        "Fix additionalProperties validation edge cases",
        "Fix required property handling",
        "Fix patternProperties regex matching",
        "Fix propertyNames validation",
        "Re-run compliance and verify object failures reduced"
      ],
      "passes": false
    },
    {
      "id": "compliance-arrays",
      "category": "integration",
      "description": "Fix compliance failures for array/tuple types",
      "steps": [
        "Run compliance, filter to array-related failures",
        "Fix items validation edge cases",
        "Fix prefixItems/additionalItems handling",
        "Fix contains/minContains/maxContains validation",
        "Fix uniqueItems deep equality comparison",
        "Re-run compliance and verify array failures reduced"
      ],
      "passes": false
    },
    {
      "id": "compliance-composition",
      "category": "integration",
      "description": "Fix compliance failures for composition keywords",
      "steps": [
        "Run compliance, filter to allOf/anyOf/oneOf failures",
        "Fix oneOf exactly-one matching logic",
        "Fix allOf property merging",
        "Fix anyOf type narrowing",
        "Fix not schema validation",
        "Re-run compliance and verify composition failures reduced"
      ],
      "passes": false
    },
    {
      "id": "compliance-final",
      "category": "integration",
      "description": "Final compliance push toward 100%",
      "steps": [
        "Run full compliance suite",
        "Categorize remaining failures",
        "Fix addressable failures",
        "Mark genuinely unsupported features in adapter-limitations.json if needed",
        "Generate final REPORT.md with pass rates",
        "Target: 100% (passed + documented unsupported)"
      ],
      "passes": false
    },
    // ============================================
    // PHASE 5: Polish
    // ============================================
    {
      "id": "error-handling",
      "category": "functional",
      "description": "Robust error handling with helpful messages",
      "steps": [
        "Handle invalid JSON input with clear error",
        "Handle unsupported schema features with warning (not crash)",
        "Handle malformed schemas gracefully",
        "Output errors as JSON to stderr: {\"error\": \"message\"}",
        "Exit with non-zero code on error",
        "Include schema path in error messages for debugging",
        "Test error handling with various malformed inputs"
      ],
      "passes": false
    },
    {
      "id": "code-quality",
      "category": "cleanup",
      "description": "Code quality and type safety improvements",
      "steps": [
        "Add type hints to all functions",
        "Add docstrings to public functions",
        "Run mypy --strict and fix type errors",
        "Ensure no runtime type errors in generated code",
        "Review and clean up any TODO comments",
        "Verify 'uv run pytest' passes in both core and adapter packages"
      ],
      "passes": false
    }
  ]
}
