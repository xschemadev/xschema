    {
      "title": "Add Twoslash to typescript.mdx client setup",
      "description": "As a user reading the TypeScript guide, I want to see types when using createXSchemaClient.",
      "acceptanceCriteria": [
        "Add twoslash to 'Use the client' code block (around line 92)",
