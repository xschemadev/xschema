{
  "project": "xschema-docs",
  "description": "AI & LLMs Features - Add LLM-friendly endpoints, copy markdown/open with AI actions, and angled TOC sidebar lines",
  "userStories": [
    {
      "title": "Enable processed markdown in source config",
      "description": "As a developer, I need the MDX processing pipeline to include raw markdown so it can be served to AI crawlers.",
      "acceptanceCriteria": [
        "Update `source.config.ts` to add `postprocess: { includeProcessedMarkdown: true }` to docs definition",
        "Typecheck passes",
        "Build succeeds (`bun run build` in web/)"
      ],
      "passes": true,
      "notes": "Added nested docs.postprocess.includeProcessedMarkdown: true to defineDocs config"
    },
    {
      "title": "Create getLLMText helper function",
      "description": "As a developer, I need a utility function to convert page data into LLM-readable text format.",
      "acceptanceCriteria": [
        "Create `web/src/lib/get-llm-text.ts`",
        "Export async function `getLLMText` that takes a page object from source",
        "Function returns string: `# {title} ({url})\\n\\n{processed content}`",
        "Uses `page.data.getText('processed')` to get content",
        "Typecheck passes"
      ],
      "passes": true,
      "notes": "Created get-llm-text.ts with getLLMText function using InferPageType from fumadocs-core/source"
    },
    {
      "title": "Create /llms-full.txt endpoint",
      "description": "As an AI crawler, I want a single endpoint that returns all documentation content so I can index the entire site.",
      "acceptanceCriteria": [
        "Create `web/src/routes/llms-full[.]txt.ts` route file",
        "Use TanStack Start pattern: `createFileRoute('/llms-full.txt')` with `server: { handlers: { GET } }`",
        "GET handler maps all pages through `getLLMText` and joins with double newlines",
        "Returns `new Response(content)` with the joined text",
        "Typecheck passes",
        "Verify `/llms-full.txt` returns content in browser"
      ],
      "passes": true,
      "notes": "Created route file with TanStack Start pattern. Uses Promise.all for parallel processing. Content-Type: text/plain; charset=utf-8. Build passes."
    },
    {
      "title": "Create per-page .mdx endpoint",
      "description": "As an AI agent, I want to get individual page content by appending .mdx to any docs URL.",
      "acceptanceCriteria": [
        "Create `web/src/routes/llms[.]mdx.docs.$.ts` route file",
        "Use TanStack Start pattern with splat param for slug",
        "Extract slug from `params._splat`, split by '/'",
        "Look up page with `source.getPage(slugs)`",
        "Return 404 (throw notFound()) if page doesn't exist",
        "Return `new Response(await getLLMText(page), { headers: { 'Content-Type': 'text/markdown' } })`",
        "Typecheck passes",
        "Verify `/llms.mdx/docs/cli/generate` returns markdown in browser"
      ],
      "passes": true,
      "notes": "Created route at llms[.]mdx.docs.$.ts. Returns markdown with title header. 404 for nonexistent pages returns TanStack's isNotFound JSON."
    },
    {
      "title": "Set up path rewriting middleware",
      "description": "As a user, I want `/docs/getting-started.mdx` to redirect to the llms endpoint automatically.",
      "acceptanceCriteria": [
        "Create `web/src/start.ts` if it doesn't exist",
        "Import `createMiddleware`, `createStart` from '@tanstack/react-start'",
        "Import `rewritePath` from 'fumadocs-core/negotiation'",
        "Import `redirect` from '@tanstack/react-router'",
        "Create middleware that rewrites `/docs{/*path}.mdx` to `/llms.mdx/docs{/*path}`",
        "Export `startInstance` with the middleware in `requestMiddleware` array",
        "Typecheck passes",
        "Verify `/docs/cli/generate.mdx` redirects to markdown content in browser"
      ],
      "passes": true,
      "notes": "Created start.ts with global middleware. Uses rewritePath from fumadocs-core/negotiation with path-to-regexp v8 syntax (/docs/{*path}.mdx). Also configured tanstackStart vite plugin with srcDirectory: 'src' for auto-discovery. Verified 307 redirect works."
    },
    {
      "title": "Add page actions UI components via CLI",
      "description": "As a developer, I need the LLMCopyButton and ViewOptions components scaffolded.",
      "acceptanceCriteria": [
        "Run `bun x @fumadocs/cli add ai/page-actions` in web/ directory",
        "Components are created in `web/src/components/` (or similar location)",
        "Files include LLMCopyButton and ViewOptions components",
        "Typecheck passes"
      ],
      "passes": false,
      "notes": "If CLI doesn't work for TanStack Start, manually create components based on fumadocs source"
    },
    {
      "title": "Integrate page actions into docs layout",
      "description": "As a user reading docs, I want copy/open-with-AI buttons visible below the title.",
      "acceptanceCriteria": [
        "Update `web/src/routes/docs/$.tsx` to import page action components",
        "Add actions container between DocsDescription and DocsBody",
        "Container uses `flex flex-row gap-2 items-center` styling",
        "Pass `markdownUrl` prop as `{page.url}.mdx` pattern",
        "Spacing between description and actions is minimal (use `pt-2 pb-4` or similar)",
        "Typecheck passes",
        "Verify in browser using dev-browser skill"
      ],
      "passes": false,
      "notes": "Need to pass page data to the client component - may need to adjust loader"
    },
    {
      "title": "Style TOC sidebar with angled tree lines",
      "description": "As a user viewing the On this page sidebar, I want angled connecting lines instead of straight vertical lines.",
      "acceptanceCriteria": [
        "Identify fumadocs TOC component CSS classes (likely `fd-toc` or similar)",
        "Add CSS to `web/src/styles/app.css` that creates angled/curved line effect",
        "Lines should use border-left and border-bottom to create L-shaped connectors",
        "Styling works in both light and dark modes",
        "Typecheck passes",
        "Verify in browser using dev-browser skill"
      ],
      "passes": false,
      "notes": "May need to inspect fumadocs source or their site to understand exact CSS approach"
    }
  ]
}
