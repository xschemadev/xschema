{
  "project": "xschema-docs",
  "description": "Build comprehensive documentation for xschema - JSON Schema to native validators with full type safety. Two user journeys (framework vs library mode), multi-language scalable structure, compliance transparency.",
  "userStories": [
    {
      "id": "US-001",
      "title": "Restructure content directory",
      "description": "As a developer, I need the docs file structure reorganized so content is logically grouped by scope (general vs language-specific).",
