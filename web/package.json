{
  "name": "web",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite dev",
    "build": "bun run generate && vite build",
    "start": "node .output/server/index.mjs",
    "generate": "bun run generate:schemas && bun run generate:compliance && bun run generate:unsupported-features",
    "generate:unsupported-features": "bun scripts/generate-unsupported-features.ts",
    "generate:schemas": "bun scripts/generate-schemas.ts",
    "generate:compliance": "bun scripts/generate-compliance.ts",
    "test": "bun test",
    "types:check": "fumadocs-mdx && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "biome check",
    "format": "biome format --write"
  },
  "dependencies": {
    "@tanstack/react-router": "1.144.0",
    "@tanstack/react-router-devtools": "1.144.0",
    "@tanstack/react-start": "1.145.3",
    "fumadocs-core": "16.4.4",
    "fumadocs-mdx": "14.2.4",
    "fumadocs-ui": "16.4.4",
    "lucide-react": "^0.562.0",
    "mermaid": "^11.12.2",
    "next-themes": "^0.4.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.4.0",
    "vite": "^7.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@tailwindcss/vite": "^4.1.18",
    "@types/bun": "^1.3.5",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.0.3"
  }
}