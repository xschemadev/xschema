{
  "name": "web",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite dev",
    "build": "bun run generate && vite build",
    "start": "node .output/server/index.mjs",
    "generate": "bun run generate:schemas && bun run generate:compliance && bun run generate:unsupported-features",
    "generate:unsupported-features": "bun scripts/generate-unsupported-features.ts",
    "generate:schemas": "bun scripts/generate-schemas.ts",
    "generate:compliance": "bun scripts/generate-compliance.ts",
    "test": "bun test",
    "types:check": "fumadocs-mdx && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "biome check",
    "format": "biome format --write"
  },
  "dependencies": {
    "@paper-design/shaders-react": "^0.0.71",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@tabler/icons-react": "^3.36.1",
    "@tanstack/react-router": "1.144.0",
    "@tanstack/react-router-devtools": "1.144.0",
    "@tanstack/react-start": "1.145.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.29.2",
    "fumadocs-core": "16.4.4",
    "fumadocs-mdx": "14.2.4",
    "fumadocs-twoslash": "^3.1.12",
    "fumadocs-ui": "16.4.4",
    "lucide-react": "^0.563.0",
    "mermaid": "^11.12.2",
    "motion": "^12.29.2",
    "next-themes": "^0.4.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.4.0",
    "twoslash": "^0.3.6",
    "vite": "^7.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@fumadocs/cli": "^1.2.2",
    "@tailwindcss/vite": "^4.1.18",
    "@types/bun": "^1.3.5",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.0.3"
  }
}
