{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "pull-request-title-pattern": "chore(release): release${component} ${version}",
  "release-type": "node",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "packages": {
    "cli": {
      "release-type": "simple",
      "component": "cli",
      "extra-files": [
        {
          "type": "json",
          "path": "release/npm/cli/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "release/npm/cli/package.json",
          "jsonpath": "$.optionalDependencies['@xschemadev/cli-darwin-arm64']"
        },
        {
          "type": "json",
          "path": "release/npm/cli/package.json",
          "jsonpath": "$.optionalDependencies['@xschemadev/cli-darwin-x64']"
        },
        {
          "type": "json",
          "path": "release/npm/cli/package.json",
          "jsonpath": "$.optionalDependencies['@xschemadev/cli-linux-arm64']"
        },
        {
          "type": "json",
          "path": "release/npm/cli/package.json",
          "jsonpath": "$.optionalDependencies['@xschemadev/cli-linux-x64']"
        },
        {
          "type": "json",
          "path": "release/npm/cli/package.json",
          "jsonpath": "$.optionalDependencies['@xschemadev/cli-win32-arm64']"
        },
        {
          "type": "json",
          "path": "release/npm/cli/package.json",
          "jsonpath": "$.optionalDependencies['@xschemadev/cli-win32-x64']"
        },
        {
          "type": "json",
          "path": "release/npm/cli-darwin-arm64/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "release/npm/cli-darwin-x64/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "release/npm/cli-linux-arm64/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "release/npm/cli-linux-x64/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "release/npm/cli-win32-arm64/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "release/npm/cli-win32-x64/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "toml",
          "path": "release/pypi/xschema-cli/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "release/pypi/xschema-cli-darwin-arm64/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "release/pypi/xschema-cli-darwin-x64/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "release/pypi/xschema-cli-linux-arm64/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "release/pypi/xschema-cli-linux-x64/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "release/pypi/xschema-cli-win32-arm64/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "release/pypi/xschema-cli-win32-x64/pyproject.toml",
          "jsonpath": "$.project.version"
        }
      ]
    },
    "typescript/packages/core": {
      "release-type": "node",
      "component": "ts-core"
    },
    "typescript/packages/client": {
      "release-type": "node",
      "component": "ts-client"
    },
    "typescript/packages/adapters/zod": {
      "release-type": "node",
      "component": "ts-zod"
    },
    "typescript/packages/adapters/arktype": {
      "release-type": "node",
      "component": "ts-arktype"
    },
    "typescript/packages/adapters/effect": {
      "release-type": "node",
      "component": "ts-effect"
    },
    "typescript/packages/adapters/typebox": {
      "release-type": "node",
      "component": "ts-typebox"
    },
    "typescript/packages/adapters/valibot": {
      "release-type": "node",
      "component": "ts-valibot"
    },
    "typescript/packages/adapters/typescript": {
      "release-type": "node",
      "component": "ts-typescript"
    },
    "python/packages/core": {
      "release-type": "python",
      "component": "py-core"
    },
    "python/packages/client": {
      "release-type": "python",
      "component": "py-client"
    },
    "python/packages/adapters/pydantic": {
      "release-type": "python",
      "component": "py-pydantic"
    }
  },
  "separate-pull-requests": true,
  "tag-separator": "-",
  "include-component-in-tag": true,
  "include-v-in-tag": true
}
